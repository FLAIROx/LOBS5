#!/bin/bash
#SBATCH --job-name=lobs5_75m_B1
#SBATCH --output=logs_lobs5/lobs5_%j.out
#SBATCH --error=logs_lobs5/lobs5_%j.err
# === 8-node config (production training) ===
#SBATCH --nodes=8
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --mem=0
#SBATCH --time=23:59:59
#SBATCH --contiguous
#SBATCH --exclude=nid[010696-010718],nid010152,nid010110,nid[011112-011115],nid011294,nid[010083-010086],nid[010561-010564],nid011108

# ============================================
# 75M Model Training Script (22 token mode)
# ============================================
# Branch: exp/B1-ignore-times (based on baseline_full_autoreg)
# Experiment: B1 — ignore_times=True baseline
# Data: GOOG 2018-2022 + JAN2023 (combined)
#
# Usage:
#   # Batch size sweep (single node)
#   for bsz in 1 2 4 8 12 16; do
#       PER_GPU_BSZ=$bsz CURTAIL_EPOCHS=10 sbatch train_full_autoreg.batch
#   done
#
#   # Full training (8 nodes) - update --nodes=8 first
#   PER_GPU_BSZ=<optimal> sbatch train_full_autoreg.batch
# ============================================

# Default per-GPU batch size (can be overridden via environment variable)
export PER_GPU_BSZ=${PER_GPU_BSZ:-8}

echo "============================================"
echo "Job started at: $(date)"
echo "Job ID: $SLURM_JOB_ID"
echo "Running on nodes: $SLURM_JOB_NODELIST"
echo "Number of nodes: $SLURM_NNODES"
echo "GPUs per node: 4"
echo "Total GPUs: $((SLURM_NNODES * 4))"
echo "============================================"

# ============================================
# 75M Model Configuration (22tok, padded_large)
# ============================================
# Based on run_lobster_padded_large.sh from baseline_full_autoreg
D_MODEL=1024
N_LAYERS=12
BLOCKS=16
SSM_SIZE_BASE=1024
SSM_LR_BASE=0.0005
LR_FACTOR=1

echo "[*] Model config: 75M (22tok, padded_large)"
echo "    d_model=$D_MODEL, n_layers=$N_LAYERS, blocks=$BLOCKS"
echo "    ssm_size_base=$SSM_SIZE_BASE, ssm_lr_base=$SSM_LR_BASE"

# CURTAIL_EPOCHS: Optional - end each epoch early after N steps (for quick testing)
if [ -n "$CURTAIL_EPOCHS" ]; then
    echo "[*] Curtail epochs: $CURTAIL_EPOCHS steps (quick test mode)"
    export CURTAIL_EPOCHS
fi

# Create logs directory
mkdir -p logs_lobs5

# Change to working directory (WORKDIR allows git worktree experiments)
WORKDIR="${WORKDIR:-/lus/lfs1aip2/projects/s5e/quant/AlphaTrade/LOBS5}"
export WORKDIR
cd "$WORKDIR"

# Configuration
GPUS_PER_NODE=4
NNODES=$SLURM_NNODES
TOTAL_GPUS=$((GPUS_PER_NODE * NNODES))

# Calculate batch sizes
GLOBAL_BSZ=$((PER_GPU_BSZ * TOTAL_GPUS))
# Each process (node) loads its own share of the batch
PER_PROCESS_BSZ=$((PER_GPU_BSZ * GPUS_PER_NODE))

echo "[*] Per GPU batch size: $PER_GPU_BSZ"
echo "[*] Total GPUs: $TOTAL_GPUS ($NNODES nodes × $GPUS_PER_NODE GPUs/node)"
echo "[*] Global batch size: $GLOBAL_BSZ (per-process: $PER_PROCESS_BSZ)"

# Multi-Node Distributed Training (JAX distributed + pmap cross-node pmean)
MASTER_ADDR=$(scontrol show hostnames $SLURM_JOB_NODELIST | head -n1)
MASTER_PORT=29500
export JAX_COORDINATOR_ADDRESS="$MASTER_ADDR:$MASTER_PORT"
export JAX_COORDINATOR_TIMEOUT_MS=600000
echo "[*] Multi-node DDP: $NNODES nodes, coordinator=$JAX_COORDINATOR_ADDRESS"

# Data paths: train on GOOG 2022, test on GOOG January 2023
export DATA_DIR="/lus/lfs1aip2/home/s5e/kangli.s5e/GOOG_GOOGL_2016TO2021_24tok_preproc/GOOG/2022"
export TEST_DIR="/projects/s5e/quant/JAN2023/GOOG_24tok_preproc"
echo "[*] Train data: $DATA_DIR"
echo "[*] Test data: $TEST_DIR"

# Launch with srun
srun --nodes=$NNODES \
     --ntasks=$NNODES \
     --ntasks-per-node=1 \
     --gres=gpu:$GPUS_PER_NODE \
     --gpu-bind=map_gpu:0,1,2,3 \
     --output=logs_lobs5/training_${SLURM_JOB_ID}_node%n.log \
     --export=ALL \
     bash -c '
# ========== Inline Wrapper ==========
echo "========================================"
echo "[Wrapper] Running on node: $(hostname)"
echo "[Wrapper] SLURM_NODEID: ${SLURM_NODEID:-N/A}"
echo "[Wrapper] SLURM_PROCID: ${SLURM_PROCID:-N/A}"
echo "[Wrapper] CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-all}"
echo "========================================"

# Source conda
source ~/miniforge3/etc/profile.d/conda.sh
conda activate lob

# Load CUDA module
module load cuda/12.6

# Set LD_LIBRARY_PATH
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusparse/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_cupti/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cufft/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nvjitlink/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusolver/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nccl/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cublas/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH

# JAX environment (aligned with ssm_stable)
# PREALLOCATE=false: disables BFC pre-allocated pool, uses CUDA native malloc per allocation.
# This prevents BFC pool fragmentation when train_step and eval_step have different allocation
# patterns across epochs. jit+sharding needs large contiguous blocks (71.62 GiB) that BFC
# can't guarantee after fragmentation. With PREALLOCATE=false, CUDA handles defragmentation.
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export TF_GPU_ALLOCATOR=cuda_malloc_async  # May not affect JAX (TF var), but harmless
export JAX_PLATFORMS="cuda"

# NCCL timeout
export NCCL_TIMEOUT=3600

# Multi-node JAX distributed info
echo "[Wrapper] SLURM_PROCID=${SLURM_PROCID:-0} (process rank)"
echo "[Wrapper] SLURM_NNODES=${SLURM_NNODES:-1} (total nodes)"
echo "[Wrapper] JAX_COORDINATOR_ADDRESS=${JAX_COORDINATOR_ADDRESS:-none}"
# NCCL debug for verification (set to WARN after verified)
export NCCL_DEBUG=WARN

# CUDA config
export CUDA_DEVICE_ORDER=PCI_BUS_ID
mkdir -p "$HOME/.nv/ComputeCache" || true

echo "[Wrapper] Available GPUs:"
nvidia-smi --list-gpus | head -4

# Run training
cd "$WORKDIR"

python -u -B run_train.py \
    --USE_WANDB=True \
    --wandb_project="${WANDB_PROJECT:-lobs5-75M-B1}" \
    --wandb_entity=kang-oxford \
    --C_init=trunc_standard_normal \
    --prenorm=True \
    --batchnorm=False \
    --bidirectional=False \
    --dataset=lobster-prediction \
    --merging=padded \
    --dir_name="'"$DATA_DIR"'" \
    --test_dir_name="'"$TEST_DIR"'" \
    --clip_eigs=True \
    --activation_fn=half_glu1 \
    --dt_global=False \
    --epochs='"${EPOCHS:-40}"' \
    --jax_seed=42 \
    --opt_config=standard \
    --p_dropout=0.0 \
    --warmup_end=1 \
    --weight_decay=0.05 \
    --msg_seq_len=500 \
    --use_book_data=True \
    --use_simple_book=False \
    --book_transform=True \
    --masking=none \
    --num_devices='"$GPUS_PER_NODE"' \
    --n_data_workers=12 \
    --debug_loading=False \
    --enable_profiler=False \
    --random_offsets_train=True \
    --shuffle_train=True \
    --debug_overfit=False \
    --ignore_times=True \
    --lr_patience=4 \
    --d_model='"$D_MODEL"' \
    --n_layers='"$N_LAYERS"' \
    --blocks='"$BLOCKS"' \
    --ssm_size_base='"$SSM_SIZE_BASE"' \
    --ssm_lr_base='"$SSM_LR_BASE"' \
    --lr_factor='"$LR_FACTOR"' \
    --bsz='"$PER_PROCESS_BSZ"' \
    ${CURTAIL_EPOCHS:+--curtail_epochs=$CURTAIL_EPOCHS}
'

echo "============================================"
echo "Training completed at: $(date)"
echo "============================================"
