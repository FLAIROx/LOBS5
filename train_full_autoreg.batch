# #   | Job ID  | BSZ/GPU | Effective BSZ | Status     | MFU    | Memory Req |
# #   |---------|---------|---------------|------------|--------|------------|
# #   | 1821927 | 16      | 64            | ✅ Running | 13-15% | -          |
# #   | 1821928 | 18      | 72            | 🔴 OOM     | -      | 83.86 GiB  |
# #   | 1821929 | 20      | 80            | 🔴 OOM     | -      | 81.40 GiB  |
# #   | 1821930 | 22      | 88            | 🔴 OOM     | -      | 86.92 GiB  |
# #   | 1821931 | 24      | 96            | 🔴 OOM     | -      | 83.81 GiB  |
# #   | 1821932 | 26      | 104           | 🔴 OOM     | -      | 108.93 GiB |
# #   | 1821933 | 28      | 112           | 🔴 OOM     | -      | 117.61 GiB |
# #   | 1821934 | 30      | 120           | 🔴 OOM     | -      | 129.11 GiB |
# #   | 1821935 | 32      | 128           | 🔴 OOM     | -      | 119.14 GiB |
# #   | 1821936 | 34      | 136           | 🔴 OOM     | -      | 138.41 GiB |




# # Source conda
# source ~/miniforge3/etc/profile.d/conda.sh
# conda activate lob26

# # Skip module load cuda - lob26 conda env has CUDA 12.9 (ptxas in CONDA_PREFIX/bin)
# module load cuda/12.6

# # Use CUDA 12.9 ptxas from lob26 conda env for Triton and XLA
# # export TRITON_PTXAS_PATH=$CONDA_PREFIX/bin/ptxas

# # Set LD_LIBRARY_PATH
# export LD_LIBRARY_PATH=$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusparse/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_cupti/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cufft/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nvjitlink/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusolver/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nccl/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cublas/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH


# # JAX environment
# export XLA_PYTHON_CLIENT_PREALLOCATE=true
# export XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
# export JAX_COORDINATOR_TIMEOUT_MS=600000
# export JAX_PLATFORMS="cuda"
# export XLA_FLAGS="--xla_gpu_autotune_max_concurrent_compilations=1${XLA_FLAGS:+ $XLA_FLAGS}"
# # **************** CHOICE 2 ****************


export TF_GPU_ALLOCATOR=cuda_malloc_async # added on Jan 4, 2026

# Multi-node JAX config
if [ -n "$JAX_COORDINATOR_ADDRESS" ]; then
    echo "[Wrapper] Multi-node coordinator: $JAX_COORDINATOR_ADDRESS"
    export JAX_PROCESS_COUNT=${SLURM_NNODES:-1}
    export JAX_PROCESS_INDEX=${SLURM_PROCID:-0}
    export JAX_LOCAL_PROCESS_COUNT=1
    export JAX_LOCAL_PROCESS_INDEX=0
    echo "[Wrapper] JAX_PROCESS_COUNT=${JAX_PROCESS_COUNT}"
    echo "[Wrapper] JAX_PROCESS_INDEX=${JAX_PROCESS_INDEX}"
fi

# CUDA config
export CUDA_DEVICE_ORDER=PCI_BUS_ID
mkdir -p "$HOME/.nv/ComputeCache" || true

echo "[Wrapper] Available GPUs:"
nvidia-smi --list-gpus | head -4

# Run training
cd /lus/lfs1aip2/projects/s5e/quant/AlphaTrade/LOBS5

# === Use MODEL_PRESET (default: 55M for 24tok) ===
python -u -B run_train.py \
    --USE_WANDB=True \
    --model_preset='"$MODEL_PRESET"' \
    --wandb_project=lobs5-55M-d1024-tbptt \
    --wandb_entity=kang-oxford \
    --C_init=trunc_standard_normal \
    --prenorm=True \
    --batchnorm=False \
    --bidirectional=False \
    --dataset=lobster-prediction \
    --merging=padded \
    --dir_name="'"$DATA_DIR"'" \
    --test_dir_name="'"$TEST_DIR"'" \
    --clip_eigs=True \
    --activation_fn=half_glu1 \
    --dt_global=False \
    --epochs=20 \
    --jax_seed=42 \
    --opt_config=standard \
    --p_dropout=0.0 \
    --warmup_end=1 \
    --weight_decay=0.05 \
    --msg_seq_len=500 \
    --use_book_data=True \
    --use_simple_book=False \
    --book_transform=True \
    --masking=none \
    --num_devices='"$GPUS_PER_NODE"' \
    --n_data_workers=12 \
    --pin_memory=True \
    --prefetch_factor=6 \
    --persistent_workers=True \
    --enable_goodput_monitor=True \
    --debug_loading=False \
    --enable_profiler=False \
    --random_offsets_train=True \
    --shuffle_train=True \
    --debug_overfit=False \
    --lr_patience=2 \
    --use_bf16=True \
    --token_mode=24 \
    --use_tbptt='"$USE_TBPTT"' \
    --tbptt_mode='"$TBPTT_MODE"' \
    --tbptt_window_size='"$TBPTT_WINDOW_SIZE"' \
    --tbptt_reset_every_epoch='"$TBPTT_RESET_EVERY_EPOCH"' \
    --n_tbptt_chunks='"$N_TBPTT_CHUNKS"' \
    ${GLOBAL_BSZ:+--global_bsz=$GLOBAL_BSZ} \
    ${CURTAIL_EPOCHS:+--curtail_epochs=$CURTAIL_EPOCHS} \
'
    # NOTE: The following parameters are now controlled by --model_preset:
    #   --blocks (preset controls)
    #   --bsz (preset controls)
    #   --d_model (preset controls)
    #   --n_layers (preset controls)
    #   --ssm_size_base (preset controls)
    #   --ssm_lr_base (preset controls)
    #   --lr_factor (preset controls)
    #   --wandb_project (preset controls)
    # --restore=/lus/lfs1aip2/projects/s5e/quant/AlphaTrade/LOBS5/checkpoints/likely-aardvark-15_p4k79dtn \
    # --restore_step=6


echo "============================================"
echo "Training completed at: $(date)"
echo "============================================"




#  ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
#  Component       Sub-component         Parameters       Ratio     Param Storage   Fwd Compute   Fwd Output   Bwd Activ Grad   Bwd Param Grad   Weight Update
#  ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
#  Fused S5        B matrix (complex)    301,989,888     29.37%     FP32            BF16†         BF16★        FP32             FP32             FP32
#  (90.00%)        C matrix (complex)    301,989,888     29.37%     FP32            BF16†         BF16★        FP32             FP32             FP32
#                  D vector                   98,304      0.01%     FP32            FP32          BF16★        FP32             FP32             FP32
#                  Λ (Lambda)                 98,304      0.01%     FP32            FP32          BF16★        FP32             FP32             FP32
#                  log_step                   49,152     <0.01%     FP32            FP32          BF16★        FP32             FP32             FP32
#                  associative_scan              —          —       —               FP32          BF16★        FP32             —                —
#                  GLU Dense             302,088,192     29.38%     FP32            BF16          BF16         BF16             FP32‡            FP32
#                  LayerNorm                 196,608      0.02%     FP32            BF16          BF16         BF16             FP32‡            FP32
#                  Encoder Dense          18,877,440      1.84%     FP32            BF16          BF16         BF16             FP32‡            FP32
#  ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
#  Msg Encoder     Embedding + Dense      63,144,960      6.14%     FP32            BF16          BF16         BF16             FP32‡            FP32
#  (6.14%)         S5 layer (internal)         (incl.)      —       FP32            BF16†         BF16         FP32             FP32             FP32
#  ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
#  Book Encoder    Pre-layers              3,350,061      0.33%     FP32            BF16          BF16         BF16             FP32‡            FP32
#  (3.24%)         Projection              1,548,288      0.15%     FP32            BF16          BF16         BF16             FP32‡            FP32
#                  Post-layers            28,328,448      2.76%     FP32            BF16          BF16         BF16             FP32‡            FP32
#  ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
#  Decoder         Dense                   6,490,176      0.63%     FP32            FP32          FP32         FP32             FP32             FP32
#  (0.63%)
#  ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
#  Loss            cross_entropy + z-loss        —          —       —               FP32§         FP32         FP32             —                —
#  ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════
#  TOTAL                               1,028,249,709    100.00%
#  ═══════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════════

#  ★ SSM: BF16 → FP32 (compute) → BF16. SSM receives BF16 input, casts to FP32 for internal computation, then casts output back to BF16.
#  † B/C matmul: FP32 params cast to BF16 for matvec, result cast back to FP32 for associative_scan.
#  ‡ All gradients cast to FP32 after backward pass (MaxText pattern) for numerical stability.
#  § Loss computed in FP32 with z-loss (weight=0.0001) to prevent logits drift in BF16 training.



