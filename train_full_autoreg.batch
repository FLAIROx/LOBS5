#!/bin/bash
#SBATCH --job-name=lobs5_autoreg
#SBATCH --output=logs_lobs5/lobs5_%j.out
#SBATCH --error=logs_lobs5/lobs5_%j.err
# === 1-node config (for 55M model testing) ===
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --mem=0
#SBATCH --time=23:59:59
#SBATCH --exclude=nid[010696-010718],nid010152,nid010110,nid[011112-011115],nid011294,nid[010083-010086],nid[010561-010564],nid011108

# === Default config for 55M model with TBPTT ar_hidden ===
# Note: ar_hidden mode requires more memory than gradient_chunking
# BSZ=8 + window=125 tested to fit in 85GB GPU
export PER_GPU_BSZ=${PER_GPU_BSZ:-8}

echo "============================================"
echo "Job started at: $(date)"
echo "Job ID: $SLURM_JOB_ID"
echo "Running on nodes: $SLURM_JOB_NODELIST"
echo "Number of nodes: $SLURM_NNODES"
echo "GPUs per node: 4"
echo "Total GPUs: $((SLURM_NNODES * 4))"
echo "============================================"

# ============================================
# Model Preset Configuration
# ============================================
# Usage:
#   MODEL_PRESET=55M sbatch train_full_autoreg.batch
#   MODEL_PRESET=1B sbatch train_full_autoreg.batch
#   MODEL_PRESET=1.4B sbatch train_full_autoreg.batch
#   PER_GPU_BSZ=4 MODEL_PRESET=1.4B sbatch train_full_autoreg.batch
#
# Available presets: 2.5B-Wide, 2.5B-Deep, 2.2B-Wide, 2.2B-Deep, 2B-Wide, 2B-Deep, 1.8B-Wide, 1.8B-Deep, 1.4B, 1B, 360M, 55M
# If not set, defaults to individual parameter values below
# PER_GPU_BSZ overrides the preset's batch size (optional)
# ============================================
MODEL_PRESET=${MODEL_PRESET:-55M}
echo "[*] Model preset: $MODEL_PRESET"
export MODEL_PRESET

if [ -n "$PER_GPU_BSZ" ]; then
    echo "[*] Batch size override: $PER_GPU_BSZ (per GPU)"
    export PER_GPU_BSZ
fi

# CURTAIL_EPOCHS: Optional - end each epoch early after N steps (for quick testing)
# Usage: CURTAIL_EPOCHS=10 MODEL_PRESET=360M sbatch train_full_autoreg.batch
if [ -n "$CURTAIL_EPOCHS" ]; then
    echo "[*] Curtail epochs: $CURTAIL_EPOCHS steps (quick test mode)"
    export CURTAIL_EPOCHS
fi

# ============================================
# TBPTT (Truncated Backpropagation Through Time)
# ============================================
# Two modes available:
#   1. gradient_chunking: splits sequence, no hidden state carry (simpler)
#   2. ar_hidden: True TBPTT with hidden state carry across windows (O(log L))
#
# Usage:
#   # True TBPTT with hidden state (recommended):
#   TBPTT_MODE=ar_hidden sbatch train_full_autoreg.batch
#
#   # Gradient chunking (no hidden carry):
#   TBPTT_MODE=gradient_chunking sbatch train_full_autoreg.batch
#
#   # Disable TBPTT entirely:
#   USE_TBPTT=False sbatch train_full_autoreg.batch
# ============================================
USE_TBPTT=${USE_TBPTT:-True}
TBPTT_MODE=${TBPTT_MODE:-ar_hidden}           # ar_hidden (True TBPTT) or gradient_chunking
TBPTT_WINDOW_SIZE=${TBPTT_WINDOW_SIZE:-125}   # messages per window for ar_hidden mode (125=3k tokens)
TBPTT_RESET_EVERY_EPOCH=${TBPTT_RESET_EVERY_EPOCH:-False}  # reset hidden at epoch start
N_TBPTT_CHUNKS=${N_TBPTT_CHUNKS:-4}           # chunks for gradient_chunking mode

echo "[*] TBPTT: $USE_TBPTT"
echo "[*] TBPTT mode: $TBPTT_MODE"
if [ "$TBPTT_MODE" = "ar_hidden" ]; then
    echo "[*] TBPTT window size: $TBPTT_WINDOW_SIZE msgs"
    echo "[*] TBPTT reset every epoch: $TBPTT_RESET_EVERY_EPOCH"
else
    echo "[*] TBPTT chunks: $N_TBPTT_CHUNKS"
fi
export USE_TBPTT TBPTT_MODE TBPTT_WINDOW_SIZE TBPTT_RESET_EVERY_EPOCH N_TBPTT_CHUNKS

# Create logs directory
mkdir -p logs_lobs5

# Change to working directory
cd /lus/lfs1aip2/projects/s5e/quant/AlphaTrade/LOBS5

# Configuration
GPUS_PER_NODE=4
NNODES=$SLURM_NNODES
TOTAL_GPUS=$((GPUS_PER_NODE * NNODES))

# Calculate global batch size (PER_GPU_BSZ * TOTAL_GPUS)
if [ -n "$PER_GPU_BSZ" ]; then
    GLOBAL_BSZ=$((PER_GPU_BSZ * TOTAL_GPUS))
else
    GLOBAL_BSZ=""
fi
export GPUS_PER_NODE NNODES TOTAL_GPUS GLOBAL_BSZ

echo "[*] Total GPUs: $TOTAL_GPUS ($NNODES nodes × $GPUS_PER_NODE GPUs/node)"
echo "[*] Global batch size: ${GLOBAL_BSZ:-preset default}"

# Multi-Node Setup
MASTER_ADDR=$(scontrol show hostnames $SLURM_JOB_NODELIST | head -n1)
MASTER_PORT=29500
export JAX_COORDINATOR_ADDRESS="$MASTER_ADDR:$MASTER_PORT"
export MASTER_ADDR
export MASTER_PORT

echo "[*] Multi-node mode: $NNODES nodes"
echo "[*] Coordinator: $JAX_COORDINATOR_ADDRESS"

# Data paths
# Data paths: train on 2022, test on 2021
export DATA_DIR="/lus/lfs1aip2/home/s5e/kangli.s5e/GOOG_GOOGL_2016TO2021_24tok_preproc/GOOG/2022"
export TEST_DIR="/lus/lfs1aip2/home/s5e/kangli.s5e/GOOG_GOOGL_2016TO2021_24tok_preproc/GOOG/2021"

# Launch with srun - inline wrapper
srun --nodes=$NNODES \
     --ntasks=$NNODES \
     --ntasks-per-node=1 \
     --gres=gpu:$GPUS_PER_NODE \
     --gpu-bind=map_gpu:0,1,2,3 \
     --output=logs_lobs5/training_${SLURM_JOB_ID}_node%n.log \
     --export=ALL \
     bash -c '
# ========== Inline Wrapper ==========
echo "========================================"
echo "[Wrapper] Running on node: $(hostname)"
echo "[Wrapper] SLURM_NODEID: ${SLURM_NODEID:-N/A}"
echo "[Wrapper] SLURM_PROCID: ${SLURM_PROCID:-N/A}"
echo "[Wrapper] CUDA_VISIBLE_DEVICES: ${CUDA_VISIBLE_DEVICES:-all}"
echo "========================================"

# **************** CHOICE 1 ****************
# Source conda
source ~/miniforge3/etc/profile.d/conda.sh
conda activate lob

# Load CUDA module
module load cuda/12.6

# Set LD_LIBRARY_PATH
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusparse/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_cupti/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cufft/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nvjitlink/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusolver/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nccl/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cublas/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH

# JAX environment
export XLA_PYTHON_CLIENT_PREALLOCATE=true
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
export JAX_COORDINATOR_TIMEOUT_MS=600000
export JAX_PLATFORMS="cuda"

# NCCL timeout: 1 hour (prevents infinite hang on communication deadlock)
export NCCL_TIMEOUT=3600



