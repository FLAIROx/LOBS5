#!/bin/bash
#SBATCH --job-name=lobs5_75m_B1
#SBATCH --output=logs_lobs5/lobs5_%j.out
#SBATCH --error=logs_lobs5/lobs5_%j.err
# === 32-node production config ===
#SBATCH --nodes=32
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --mem=0
#SBATCH --time=24:00:00


# --- 32-node 24h production submit command ---
# sbatch --nodes=32 --time=24:00:00 train_full_autoreg.batch
#
# ============================================
# LR Scaling Theory for Batch Size Changes
# ============================================
#
# When scaling batch size by factor κ = new_BSZ / old_BSZ:
#
# (a) Linear Scaling (LR × κ) — for SGD
#     Goyal et al. 2017, "Accurate, Large Minibatch SGD: Training ImageNet in 1 Hour"
#     Ref: https://arxiv.org/abs/1706.02677
#
#     SGD update:  Δw = -LR × ∇L(w)
#     Gradient noise:  Var(∇L) ∝ σ² / B
#     When B × κ: gradient variance ÷ κ → LR must also × κ
#     Applies to: SGD (with momentum), CV tasks, medium batch (8K-64K)
#
# (b) Square Root Scaling (LR × √κ) — for Adam/AdamW  ★ THIS PROJECT ★
#     Hoffer et al. 2017; Krizhevsky 2014; Princeton SDE Framework 2024
#     Ref: https://arxiv.org/abs/1705.03341
#     Ref: https://www.cs.princeton.edu/~smalladi/blog/2024/01/22/SDEs-ScalingRules/
#
#     Adam update:  Δw = -LR × m̂ / (√v̂ + ε)
#                              ↑ adaptive term already compensates noise
#     Key difference:
#       SGD:   noise → directly affects update direction & magnitude → full compensation → × κ
#       Adam:  v̂ (2nd moment) already tracks gradient variance → only compensate "variance of variance" → × √κ
#
#     AED (Aligned Equation Derivation):
#       Var(Adam_update) ∝ LR² × Var(m̂/(√v̂+ε))
#                        ∝ LR² × 1/B     (approximation)
#       To maintain Var constant:
#         LR_new² / B_new = LR_old² / B_old
#         LR_new = LR_old × √(B_new / B_old)
#                = LR_old × √κ
#
#     2024 NeurIPS Surge Phenomenon (Ref: https://arxiv.org/abs/2405.14578):
#       Adam's optimal LR is NOT monotonically increasing with batch size.
#       Small→medium batch: LR ∝ √κ (growth phase)
#       Medium→large batch: LR peaks then may decrease
#       → Always do a sweep, don't blindly trust the formula.
#
# This project: AdamW optimizer (optax standard config), S5 SSM, 75M params
#   Baseline:  BSZ=28  (7 GPU × 4/GPU),  LR=5e-4
#   128 GPU:   BSZ=1536 (128 GPU × 12/GPU), κ=54.9, √κ=7.4 → LR≈3.7e-3
#
# ============================================
#
# --- ssm_lr_base sweep (32N, 80min, no curtail, normal training) ---
# SSM_LR_BASE=1e-4  sbatch --nodes=32 --time=01:20:00 train_full_autoreg.batch
# SSM_LR_BASE=3e-4  sbatch --nodes=32 --time=01:20:00 train_full_autoreg.batch
# SSM_LR_BASE=5e-4  sbatch --nodes=32 --time=01:20:00 train_full_autoreg.batch  # current default ★
# SSM_LR_BASE=1e-3  sbatch --nodes=32 --time=01:20:00 train_full_autoreg.batch  # argparse default
# SSM_LR_BASE=2e-3  sbatch --nodes=32 --time=01:20:00 train_full_autoreg.batch
# SSM_LR_BASE=5e-3  sbatch --nodes=32 --time=01:20:00 train_full_autoreg.batch
# SSM_LR_BASE=1e-2  sbatch --nodes=32 --time=01:20:00 train_full_autoreg.batch

# ============================================
# Reproduce baseline_full_autoreg (GOOG 2022)
# ============================================
# Baseline branch: baseline_full_autoreg at commit 9386d01 (2026-01-27)
# Original runs: twilight-sound-77 (bsz=28, 7GPU), sleek-night-72/robust-darkness-68 (bsz=32, 8GPU)
# Original config: micro_bsz=4, ignore_times=False, ssm_lr_base=5e-4, epochs=40
# Created: 2026-02-22
#
# PER_GPU_BSZ=1 IGNORE_TIMES=False EPOCHS=40 sbatch --nodes=8 --time=24:00:00 train_full_autoreg.batch
#
# ============================================
# 75M Model Training Script (22 token mode)
# ============================================
# Branch: exp/B1-ignore-times (based on baseline_full_autoreg)
# Experiment: B1 — ignore_times=True baseline
# Data: GOOG 2018-2022 + JAN2023 (combined)
#
# Usage:
#   # Batch size sweep (single node)
#   for micro_bsz in 1 2 4 8 12 16; do
#       PER_GPU_BSZ=$micro_bsz CURTAIL_EPOCHS=10 sbatch train_full_autoreg.batch
#   done
#
#   # Full training (8 nodes) - update --nodes=8 first
#   PER_GPU_BSZ=<optimal> sbatch train_full_autoreg.batch
# ============================================

# Default per-GPU batch size (can be overridden via environment variable)
export PER_GPU_BSZ=${PER_GPU_BSZ:-10}

# Multi-node: default to hierarchical shard_map (2D mesh)
# Hierarchical splits allreduce into NVLink (intra-node) + Slingshot (inter-node)
# Without it, 32N is 2.18x slower (2.05 vs 0.94 s/step) due to flat 128-GPU ring
# Job 2426414: forgot HIERARCHICAL=True → 1D flat mesh → 2.05 s/step (should be 0.94)
if [ "${SLURM_NNODES:-1}" -ge 2 ]; then
  export HIERARCHICAL=${HIERARCHICAL:-True}
fi

# Local SGD: sync params every K steps instead of grads every step.
# K=0 (default): standard AllReduce every step.
# K>0: each node trains independently with BSZ=PER_GPU_BSZ*4, params averaged every K steps.
# Effective per-step BSZ = PER_GPU_BSZ * GPUS_PER_NODE (not * total_GPUs).
export LOCAL_SGD_K=${LOCAL_SGD_K:-0}

echo "============================================"
echo "Job started at: $(date)"
echo "Job ID: $SLURM_JOB_ID"
echo "Running on nodes: $SLURM_JOB_NODELIST"
echo "Number of nodes: $SLURM_NNODES"
echo "GPUs per node: 4"
echo "Total GPUs: $((SLURM_NNODES * 4))"
echo "============================================"

# ============================================
# 75M Model Configuration (22tok, padded_large)
# ============================================
# Based on run_lobster_padded_large.sh from baseline_full_autoreg
D_MODEL=1024
N_LAYERS=12
BLOCKS=16
SSM_SIZE_BASE=1024
SSM_LR_BASE=${SSM_LR_BASE:-5e-4}
LR_FACTOR=${LR_FACTOR:-1}
WARMUP_END=${WARMUP_END:-1}

echo "[*] Model config: 75M (22tok, padded_large)"
echo "    d_model=$D_MODEL, n_layers=$N_LAYERS, blocks=$BLOCKS"
echo "    ssm_size_base=$SSM_SIZE_BASE, ssm_lr_base=$SSM_LR_BASE"

# CURTAIL_EPOCHS: Optional - end each epoch early after N steps (for quick testing)
if [ -n "$CURTAIL_EPOCHS" ]; then
    echo "[*] Curtail epochs: $CURTAIL_EPOCHS steps (quick test mode)"
    export CURTAIL_EPOCHS
fi

# Mid-epoch checkpoint: save every N steps or "auto" (30min time-based)
CHECKPOINT_EVERY=${CHECKPOINT_EVERY:-"auto"}
MAX_JOB_HOURS=${MAX_JOB_HOURS:-"24.0"}
export CHECKPOINT_EVERY MAX_JOB_HOURS
echo "[*] Mid-epoch checkpoint: every=$CHECKPOINT_EVERY, max_job_hours=$MAX_JOB_HOURS"

# Restore from mid-epoch checkpoint
if [ -n "$RESTORE_PATH" ]; then
    echo "[*] Restore from: $RESTORE_PATH (step=${RESTORE_STEP:-latest})"
fi
if [ -n "$RESUME_FROM_STEP" ]; then
    echo "[*] Resume from batch_idx=$RESUME_FROM_STEP within epoch"
fi

# Create logs directory
mkdir -p logs_lobs5

# Change to working directory (WORKDIR allows git worktree experiments)
WORKDIR="${WORKDIR:-/lus/lfs1aip2/projects/s5e/quant/AlphaTrade/LOBS5}"
export WORKDIR
cd "$WORKDIR"

# Configuration
GPUS_PER_NODE=${GPUS_PER_NODE:-4}
NNODES=$SLURM_NNODES
export NNODES  # Must export for bash -c wrapper to see it
TOTAL_GPUS=$((GPUS_PER_NODE * NNODES))

# Calculate batch sizes
GLOBAL_BSZ=$((PER_GPU_BSZ * TOTAL_GPUS))
# Each node-process loads data for all its GPUs
PER_PROCESS_BSZ=$((PER_GPU_BSZ * GPUS_PER_NODE))

echo "[*] Per GPU batch size: $PER_GPU_BSZ"
echo "[*] Total GPUs: $TOTAL_GPUS ($NNODES nodes × $GPUS_PER_NODE GPUs/node)"
echo "[*] Global batch size: $GLOBAL_BSZ (per-process: $PER_PROCESS_BSZ)"

# Multi-Node Distributed Training (JAX distributed + pmap cross-node pmean)
MASTER_ADDR=$(scontrol show hostnames $SLURM_JOB_NODELIST | head -n1)
MASTER_PORT=29500
export JAX_COORDINATOR_ADDRESS="$MASTER_ADDR:$MASTER_PORT"
export JAX_COORDINATOR_TIMEOUT_MS=600000
echo "[*] Multi-node DDP: $NNODES nodes, coordinator=$JAX_COORDINATOR_ADDRESS"

# Data paths: train on GOOG 2022, test on GOOG January 2023
export DATA_DIR="/lus/lfs1aip2/home/s5e/kangli.s5e/GOOG_GOOGL_2016TO2021_24tok_preproc/GOOG/2022"
export TEST_DIR="/projects/s5e/quant/JAN2023/GOOG_24tok_preproc"
echo "[*] Train data: $DATA_DIR"
echo "[*] Test data: $TEST_DIR"

# Launch with srun (1 process per node, each managing GPUS_PER_NODE GPUs)
# --kill-on-bad-exit=1: if ANY rank exits non-zero, srun kills ALL ranks immediately.
# Without this, a watchdog-killed rank leaves 127 others stuck in NCCL wait forever.
srun --nodes=$NNODES \
     --ntasks=$NNODES \
     --ntasks-per-node=1 \
     --gres=gpu:$GPUS_PER_NODE \
     --gpu-bind=map_gpu:0,1,2,3 \
     --kill-on-bad-exit=1 \
     --output=logs_lobs5/training_${SLURM_JOB_ID}_node%n.log \
     --export=ALL \
     bash -c '
# ========== Inline Wrapper ==========
# 1 process per node, all GPUs visible

echo "========================================"
echo "[Wrapper] Running on node: $(hostname)"
echo "[Wrapper] SLURM_NODEID: ${SLURM_NODEID:-N/A}"
echo "[Wrapper] SLURM_PROCID: ${SLURM_PROCID:-N/A}"
echo "[Wrapper] SLURM_LOCALID: ${SLURM_LOCALID:-N/A}"
echo "[Wrapper] CUDA_VISIBLE_DEVICES: $CUDA_VISIBLE_DEVICES"
echo "========================================"

# Source conda
source ~/miniforge3/etc/profile.d/conda.sh
conda activate ${CONDA_ENV:-lob}

# Load CUDA module
module load cuda/12.6

# Set LD_LIBRARY_PATH
# NCCL override: use base env's NCCL 2.29.3 (fixes ARM CAS weak failure hang, NCCL release 2025-02-03)
# The lob env has NCCL 2.28.9 which has the ARM CAS bug. Base env was upgraded via pip.
# Prepend base env's nccl/lib so it loads BEFORE the conda env's 2.28.9 version.
NCCL_LIB_OVERRIDE=~/miniforge3/lib/python3.12/site-packages/nvidia/nccl/lib
export LD_LIBRARY_PATH=$NCCL_LIB_OVERRIDE:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusparse/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_cupti/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cufft/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nvjitlink/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusolver/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nccl/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cublas/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH

# NCCL OFI plugin for cross-node communication via Slingshot/libfabric
export LD_LIBRARY_PATH=/tools/brics/apps/linux-sles15-neoverse_v2/gcc-12.3.0/aws-ofi-nccl-1.8.1-c47cd5ivrugm3jzlyqyis4igyflnydmo/lib:/opt/cray/libfabric/1.22.0/lib64:$LD_LIBRARY_PATH

# JAX environment
export XLA_PYTHON_CLIENT_PREALLOCATE=true
# 2D mesh (hierarchical) creates two NCCL communicators (gpus+nodes), more buffer needed
# 32+ nodes: 0.80 (XLA HLO planner is greedy — 0.85 just makes it allocate MORE, not leave headroom)
#   Job 2439132: MEM=0.80 → XLA requested 73.5 GiB (96.7% of 76 GB) → OOM epoch 11
#   Job 2439639: MEM=0.85 → XLA requested 78.7 GiB (96.4% of 81.6 GB) → OOM step 0
#   Fix: reduce PER_GPU_BSZ (12→10), not increase MEM_FRACTION
# 8-16N: 0.85 (moderate overhead)
# Override with MEM_FRACTION env var for BSZ tuning (e.g. MEM_FRACTION=0.85)
if [ -z "${MEM_FRACTION}" ]; then
  if [ "${NNODES}" -ge 32 ] && [ "${HIERARCHICAL}" = "True" ]; then
    export XLA_PYTHON_CLIENT_MEM_FRACTION=0.80
  elif [ "${NNODES}" -ge 8 ] && [ "${HIERARCHICAL}" = "True" ]; then
    export XLA_PYTHON_CLIENT_MEM_FRACTION=0.85
  else
    export XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
  fi
else
  export XLA_PYTHON_CLIENT_MEM_FRACTION=${MEM_FRACTION}
fi
export JAX_PLATFORMS="cuda"
export TF_GPU_ALLOCATOR=cuda_malloc_async

# CAVEAT — XLA FLAGS FOR MULTI-HOST AUTOTUNER
# autotune_level=0 is FORBIDDEN — XLA AutoTune (kernel fusion) is why we use JAX
#
# JAX 0.9.0 had multi-host autotuner crash: autotuner.cc:260 DEVICE_TYPE_INVALID
# Root cause: non-deterministic iteration + unsorted sharding across hosts
# Fixed in JAX 0.9.0.1 via XLA#36579 + XLA#36755
# CAVEAT: DO NOT re-enable these flags unless downgrading below JAX 0.9.0.1
# CAVEAT: ssm-stable, HyperscaleES, MaxText all use XLA defaults (no flags)
# Rollback to JAX 0.9.0: pip install jax==0.9.0 jaxlib==0.9.0 jax-cuda12-pjrt==0.9.0 jax-cuda12-plugin==0.9.0
# export XLA_FLAGS="${XLA_FLAGS:---xla_gpu_enable_triton_gemm=false --xla_gpu_shard_autotuning=false}"
# Force all CUDA modules to load at startup (vs LAZY default which loads on first use).
# Why EAGER: in multi-node training, lazy loading causes non-deterministic load timing
# across nodes → NCCL collective timeouts and XLA autotuner device-binding races.
# Trade-off: slightly slower startup, but eliminates mid-training CUDA load stalls.
# XLA AllReduce fusion for multi-node scaling (ref: MaxText GPU config)
# Without this, XLA creates 101 independent AllReduce ops (one per param tensor).
# 16-rank ring on 4N has 91ms/op launch latency → 101*91ms = 9.2s per step.
# With 128MB threshold, XLA combines into 2-3 large AllReduces → ~3*91ms = 0.27s.
# Profiler evidence: jobs 2381959(2N) vs 2381960(4N), 101 ops/step both configs.
# Latency hiding scheduler overlaps remaining AllReduce with compute.
export XLA_FLAGS="${XLA_FLAGS} \
  --xla_gpu_all_reduce_combine_threshold_bytes=134217728 \
  --xla_gpu_enable_latency_hiding_scheduler=true \
  --xla_gpu_enable_highest_priority_async_stream=true \
  --xla_gpu_nccl_terminate_on_error=true \
  --xla_gpu_nccl_termination_timeout_seconds=600 \
  --xla_gpu_all_reduce_blueconnect_num_devices_per_host=4"

# 8+ nodes with shard_map: disable shard_autotuning
# The old CAVEAT (job 2421931: JIT >30min at 16N) was for 1D DDP without shard_map.
# With shard_map 2D mesh, shard_autotuning adds overhead: 16N 1.58→? s/step (testing).
# 32N with autotuning off: 0.94 s/step (58.4% eff); 16N with autotuning on: 1.58 s/step (34.8% eff).
if [ "${NNODES}" -ge 8 ] && [ "${HIERARCHICAL}" = "True" ]; then
  export XLA_FLAGS="${XLA_FLAGS} --xla_gpu_shard_autotuning=false"
  echo "[XLA] ${NNODES}N hierarchical: shard_autotuning disabled"
fi

export CUDA_MODULE_LOADING=EAGER
echo "[XLA] XLA_FLAGS=${XLA_FLAGS}"

# NCCL config
# NCCL_TIMEOUT=3600 did NOT prevent a 6h hang at 32N (job 2426449, epoch 14 step 356).
# Multiple timeout mechanisms for broader NCCL version compatibility:
export NCCL_TIMEOUT=600                     # 10 min (NCCL 2.19+, seconds)
export NCCL_BLOCKING_WAIT=0                 # Non-blocking wait mode (NCCL 2.x)
export NCCL_ASYNC_ERROR_HANDLING=1           # Async error handling (NCCL 2.13+)
export NCCL_LAUNCH_ORDER_IMPLICIT=1         # Implicit ordering for multi-communicator ops (NCCL 2.26+)

# NCCL_BUFFSIZE=2MB — CRITICAL for multi-node shard_map performance
# Experimentally verified (C5a, 2026-02-21):
#   16N + BUFF=default(4MB): 1.58 s/step (34.8% eff) — Jobs 2424845, 2425406, 2426301
#   16N + BUFF=2MB:          0.66 s/step (83.3% eff) — Job 2426303  → 2.4x faster!
#   32N + BUFF=2MB:          0.94 s/step (58.5% eff) — Job 2424846
# With 40 NCCL channels (default on GH200), 4MB per channel saturates Slingshot
# injection bandwidth. 2MB reduces per-chunk size, improving pipeline efficiency.
# This is the sole cause of the previous 16N<32N efficiency anomaly.
if [ "${NNODES}" -ge 2 ]; then
  export NCCL_BUFFSIZE=2097152
  echo "[NCCL] Multi-node: NCCL_BUFFSIZE=2MB (verified 2.4x speedup at 16N)"
fi

# Isambard GH200 Slingshot best practices (ref: docs.isambard.ac.uk, NCCL Issue #1272)
# Experimentally: no measurable impact alone (1.60 vs 1.58 s/step), but recommended.
export NCCL_MIN_NCHANNELS=4
export NCCL_NCHANNELS_PER_NET_PEER=4
# CAVEAT — DO NOT re-enable NCCL_P2P_DISABLE=1
# GH200 nodes HAVE NV6 (6x NVLink bonded, 478 GB/s) between all 4 GPUs.
# P2P_DISABLE=1 forces intra-node comm to SHM (CPU memcpy, ~50 GB/s),
# causing 25x slowdown on 4N+ (11.2 s/step vs 0.46 s/step).
# 2N is unaffected because each NCCL comm has localRanks=1 (no intra-node comm).
# Verified: nvidia-smi topo -m shows NV6 between all GPU pairs.
#export NCCL_P2P_DISABLE=1

# NCCL collective algorithm — both TREE and RING are slow on 4N Slingshot
# NCCL_ALGO=TREE: crash, AllGather does not support TREE — job 2382073
# NCCL_ALGO=allreduce:tree: 21.83 s/step, TREE 2.2x SLOWER than RING — job 2382095
# NCCL_ALGO default RING: 9.78 s/step — job 2381259
# Root cause is XLA AllReduce combine threshold (see XLA_FLAGS above), not NCCL algo.
#export NCCL_ALGO="allreduce:tree"

# Slingshot/CXI optimization — PERFORMANCE tuning
# TESTED job 2382150: 13.36 s/step — 37% WORSE than baseline (9.78).
# Root cause of regression: NCCL_CROSS_NIC=1 + NCCL_NET_GDR_LEVEL=PHB, NOT the CXI hang-prevention vars.
# These two are harmful on our Slingshot topology. Do not re-enable without single-variable benchmarking.
#export NCCL_CROSS_NIC=1                   # CAVEAT: tested harmful (job 2382150)
#export NCCL_NET_GDR_LEVEL=PHB             # CAVEAT: tested harmful (job 2382150)
#export NCCL_PROTO=^LL128                  # TODO: test separately (CSCS says LL128 worse on Slingshot)
#export FI_CXI_DEFAULT_CQ_SIZE=131072      # TODO: test separately
#export FI_CXI_DEFAULT_TX_SIZE=16384       # TODO: test separately
#export FI_CXI_RX_MATCH_MODE=software      # TODO: test separately (may affect small message perf)

# Slingshot CXI resilience — prevent NCCL deadlocks at 8+ nodes
# These are RESILIENCE tuning — no normal-path performance impact, only fault recovery.
# Root cause analysis (2026-02-23, HLO profiling + deep research):
#   - eval_step has ZERO NCCL collectives (HLO verified, Job 2440089)
#   - train_step has 336 AllReduce/step (169 intra-node + 167 inter-node)
#   - 32N × 336 × 549 steps/epoch × 6 epochs = ~1.1M collectives before hang
#   - NCCL 2.29.3 fixes ARM CAS weak failure (exactly our GH200 ARM platform)
#   - CXI eager message race condition is CSCS+Isambard+ALCF consensus workaround
if [ "${SLURM_NNODES:-1}" -ge 8 ]; then
  # --- Existing resilience ---
  export FI_CXI_RDZV_RETRIES=100           # default=5, survive transient Slingshot fabric errors
  export FI_CXI_OFLOW_BUF_SIZE=8388608     # 8MB overflow buffer (prevent CXI ENOMEM under bursty traffic)
  export FI_CXI_REQ_BUF_SIZE=8388608       # 8MB request buffer (reduce flow control stalls)

  # --- NEW: CXI hang prevention (CSCS + Isambard + ALCF consensus) ---
  # Disable eager messages to prevent CXI race condition under high concurrency.
  # CXI eager path buffer management has race condition at 128 GPU bursty traffic.
  # Setting all three to 0 forces rendezvous-only path for all message sizes.
  export FI_CXI_RDZV_GET_MIN=0             # Disable eager GET minimum size
  export FI_CXI_RDZV_THRESHOLD=0           # Force all messages through rendezvous
  export FI_CXI_RDZV_EAGER_SIZE=0          # No eager data in rendezvous
  export FI_CXI_RDZV_PROTO=alt_read        # Alternate read protocol (ALCF verified up to 540 nodes)

  # --- NEW: Host register deadlock prevention (Isambard docs) ---
  # Multi-process per GPU → page locking competition → deadlock
  export FI_CXI_DISABLE_HOST_REGISTER=1    # Prevent host buffer GPU registration deadlock
  export FI_MR_CACHE_MONITOR=userfaultfd   # Memory registration cache monitor

  # --- NEW: Prevent GPU-aware MPI + NCCL collision (CSCS docs) ---
  export MPICH_GPU_SUPPORT_ENABLED=0       # "easily leads to deadlocks" - CSCS

  echo "[CXI] ${SLURM_NNODES}N: Full CXI resilience (RDZV_RETRIES=100, eager=off, alt_read, host_reg=off)"
fi

# Multi-node JAX distributed info
echo "[Wrapper] SLURM_PROCID=${SLURM_PROCID:-0} (process rank)"
echo "[Wrapper] SLURM_NNODES=${SLURM_NNODES:-1} (total nodes)"
echo "[Wrapper] JAX_COORDINATOR_ADDRESS=${JAX_COORDINATOR_ADDRESS:-none}"
# NCCL debug for cross-node verification (set to WARN after verified)
export NCCL_DEBUG=${NCCL_DEBUG:-INFO}

# CUDA config
export CUDA_DEVICE_ORDER=PCI_BUS_ID
mkdir -p "$HOME/.nv/ComputeCache" || true

echo "[Wrapper] Available GPUs:"
nvidia-smi --list-gpus | head -4

# Run training
cd "$WORKDIR"

python -u -B run_train.py \
    --USE_WANDB=True \
    --wandb_project="${WANDB_PROJECT:-lobs5-75M-B1}" \
    --wandb_entity=kang-oxford \
    --C_init=trunc_standard_normal \
    --prenorm=True \
    --batchnorm=False \
    --bidirectional=False \
    --dataset=lobster-prediction \
    --merging=padded \
    --dir_name="'"$DATA_DIR"'" \
    --test_dir_name="'"$TEST_DIR"'" \
    --clip_eigs=True \
    --activation_fn=half_glu1 \
    --dt_global=False \
    --epochs='"${EPOCHS:-40}"' \
    --jax_seed=42 \
    --opt_config=standard \
    --p_dropout=0.0 \
    --warmup_end='"$WARMUP_END"' \
    --weight_decay=0.05 \
    --msg_seq_len=500 \
    --use_book_data=True \
    --use_simple_book=False \
    --book_transform=True \
    --masking=none \
    --num_devices='"$GPUS_PER_NODE"' \
    --n_data_workers=12 \
    --debug_loading=False \
    --enable_profiler=False \
    --random_offsets_train=True \
    --shuffle_train=True \
    --debug_overfit=False \
    --ignore_times='"${IGNORE_TIMES:-True}"' \
    --lr_patience=4 \
    --d_model='"$D_MODEL"' \
    --n_layers='"$N_LAYERS"' \
    --blocks='"$BLOCKS"' \
    --ssm_size_base='"$SSM_SIZE_BASE"' \
    --ssm_lr_base='"$SSM_LR_BASE"' \
    --lr_factor='"$LR_FACTOR"' \
    --micro_bsz='"$PER_GPU_BSZ"' \
    ${CURTAIL_EPOCHS:+--curtail_epochs=$CURTAIL_EPOCHS} \
    ${RESTORE_PATH:+--restore=$RESTORE_PATH} \
    ${RESTORE_STEP:+--restore_step=$RESTORE_STEP} \
    ${RESUME_FROM_STEP:+--resume_from_step=$RESUME_FROM_STEP} \
    ${HIERARCHICAL:+--hierarchical=$HIERARCHICAL} \
    ${LOCAL_SGD_K:+--local_sgd_k=$LOCAL_SGD_K} \
    --checkpoint_every_n_steps='"$CHECKPOINT_EVERY"' \
    --max_job_hours='"$MAX_JOB_HOURS"'
'

SRUN_EXIT=$?
echo "============================================"
echo "Training finished at: $(date)"
echo "srun exit code: $SRUN_EXIT"
echo "============================================"

# Auto-resume on watchdog kill or NCCL deadlock
# Exit codes: 0=success, 1=watchdog kill, 126=NCCL error, 137=SIGKILL
# Only auto-resume for full training runs (no CURTAIL_EPOCHS) to avoid infinite loops
if [ "$SRUN_EXIT" -ne 0 ] && [ -z "${CURTAIL_EPOCHS:-}" ] && [ -z "${NO_AUTO_RESUME:-}" ]; then
  # Find latest checkpoint directory
  CKPT_BASE="$WORKDIR/checkpoints"
  if [ -d "$CKPT_BASE" ]; then
    LATEST_CKPT=$(ls -1d "$CKPT_BASE"/epoch_* 2>/dev/null | sort -V | tail -1)
    if [ -n "$LATEST_CKPT" ]; then
      RESUME_EPOCH=$(basename "$LATEST_CKPT" | sed 's/epoch_//')
      echo "[Auto-Resume] srun failed (exit=$SRUN_EXIT). Latest checkpoint: $LATEST_CKPT (epoch $RESUME_EPOCH)"
      echo "[Auto-Resume] Resubmitting with RESTORE_PATH=$LATEST_CKPT"

      # Resubmit the same job with RESTORE_PATH, inheriting all current env vars
      # --dependency=afterany ensures it starts after this job fully finishes
      RESTORE_PATH="$LATEST_CKPT" NO_AUTO_RESUME_DEPTH=$((${NO_AUTO_RESUME_DEPTH:-0} + 1)) \
        sbatch --nodes=${SLURM_NNODES} --time=${SBATCH_TIMELIMIT:-24:00:00} \
               --dependency=afterany:${SLURM_JOB_ID} \
               "$0"
      echo "[Auto-Resume] Submitted. Max resume depth: ${NO_AUTO_RESUME_DEPTH:-0}/3"

      # Safety: stop after 3 consecutive auto-resumes
      if [ "${NO_AUTO_RESUME_DEPTH:-0}" -ge 3 ]; then
        echo "[Auto-Resume] WARNING: Reached 3 consecutive auto-resumes. Stopping to prevent infinite loop."
      fi
    else
      echo "[Auto-Resume] No checkpoint found in $CKPT_BASE. Cannot resume."
    fi
  else
    echo "[Auto-Resume] Checkpoint directory $CKPT_BASE not found."
  fi
else
  if [ "$SRUN_EXIT" -eq 0 ]; then
    echo "[*] Training completed successfully."
  elif [ -n "${CURTAIL_EPOCHS:-}" ]; then
    echo "[*] Test run (CURTAIL_EPOCHS=$CURTAIL_EPOCHS) finished with exit=$SRUN_EXIT"
  fi
fi



'''
================================================================================
ignore-times-shard-map Branch: Training Data / Test Data / Default Metrics Overview
================================================================================

Based on HEAD: fe24db5, default 32 nodes (128 GPUs) configuration

--------------------------------------------------------------------------------

1. DATA OVERVIEW

1.1 Dataset Partitioning

Partition     Data Path                                                           Days      Source              Method
---------     ---------                                                           ----      ------              ------
Train Set     /lus/lfs1aip2/home/s5e/kangli.s5e/.../GOOG/2022                     249 d     GOOG 2022 Full      Main directory files
Val Set       Randomly sampled from training set                                  ~25 d     GOOG 2022 Subset    Date-level random sampling
Test Set      /projects/s5e/quant/JAN2023/GOOG_24tok_preproc                      9 d       GOOG Jan 2023       Temporal extrapolation

Key Design: The validation set is sampled at the "date" level from the training set (not random message sampling) to ensure time-series independence. The test set uses independent data from Jan 2023 to verify temporal extrapolation.

1.2 Data Format: 22 Token Message Encoding

Each LOB message is 22 tokens, divided into 8 new event fields (18 tok) + 4 reference fields (4 tok).

Message Structure (22 tokens):
┌──────────────────── New Event Fields (18 tok) ────────────────────┐┌── Reference Fields (4 tok) ──┐
│ idx:  0    1    2-3   4    5    6-8    9-10   11-13              │ 14-15  16   17-18  19-21     │
│       │    │    │     │    │    │      │      │                  │  │      │    │      │        │
│      evt  dir  price size dt_s dt_ns  time_s time_ns            │ p_ref sz_r ts_ref tns_ref   │
└───────────────────────────────────────────────────────────────────┘└─────────────────────────────┘
                                        ^---- ignore_times removes these 5 tokens (idx 9-13)

Token Index   Field Name      Count   Type         Range                Description
-----------   ----------      -----   ----         -----                -----------
0             event_type      1       event_type   {1,2,3,4}            1=New, 2=Cancel, 3=Delete, 4=Trade
1             direction       1       direction    {0,1}                0=Ask, 1=Bid
2-3           price           2       sign+price   sign+/-1, val 999    Relative price (ticks)
4             size            1       size         [0, 9999]            Order quantity (shares)
5             delta_t_s       1       time         [0, 999]             Interval (seconds)
6-8           delta_t_ns      3       time         3x[0,999]            Interval (nanoseconds)
9-10          time_s          2       time         2x[0,999]            Exchange time sec (removed)
11-13         time_ns         3       time         3x[0,999]            Exchange time ns (removed)
14-15         price_ref       2       sign+price   Same as price        Reference price
16            size_ref        1       size         [0, 9999]            Reference quantity
17-18         time_s_ref      2       time         2x[0,999]            Reference time sec
19-21         time_ns_ref     3       time         3x[0,999]            Reference time ns

1.3 Vocabulary

Encoding Domain       Size    Token Range    Description
---------------       ----    -----------    -----------
Special tokens        4       0-3            MASK=0, HIDDEN=1, NA=2, START=3
time                  1000    4-1003         Digits 0-999, delimiter at [3,6,9,12]
event_type            4       1004-1007      Types 1-4
size                  10000   1008-11007     Quantity 0-9999
price                 1000    11008-12007    Price digits 0-999
sign                  2       12008-12009    Sign {-1, +1}
direction             2       12010-12011    Direction {0, 1}
Total n_classes       ~12012                 Returned by Vocab.__len__()

1.4 Sequence Dimensions

Parameter             Value      Formula      Description
---------             -----      -------      -----------
msg_seq_len           500        (CLI arg)    History messages per sample
MSG_LEN               22         (constant)   Tokens per message
seq_len (total)       11000      500 x 22     Total tokens per sample
Effective loss tok    8500       500 x 17     After removing time_s/ns
n_classes             ~12012     Vocab size   Output softmax classes

--------------------------------------------------------------------------------

2. IGNORE_TIMES MECHANISM DETAILS

2.1 Core Implementation

ignore_times=True does NOT change model input (still 22 tok); it only affects the loss and accuracy calculation.

Implementation location: lob/train_helpers.py

Context                     Function                     Lines        Purpose
-------                     --------                     -----        -------
Training loss               train_step() -> loss_fn()    L728-733     Remove idx 9-13 from CE loss
Hierarchical train loss     sharded_step() version       L1171-1176   Same, shard_map version
Validation/test loss        eval_step()                  L1008-1015   Remove idx 9-13 from CE loss
Validation/test accuracy    eval_step()                  L1017-1024   Remove idx 9-13 from accuracy

2.2 Mathematical Effect

Original CE loss:     L = mean(CE[0:22])            - average over all 22 positions
ignore_times CE:      L = mean(CE[0:9] + CE[14:22]) - average over 17 positions only

(+) denotes concatenation. Removed tokens: idx 9-10 (time_s), 11-13 (time_ns).

2.3 Design Motivation

Reason                      Explanation
------                      -----------
Time unpredictability       Absolute timestamps (HH:MM:SS) are meaningless for prediction
Loss perturbation           5/22 (22.7%) of loss comes from unpredictable time tokens
Preserves delta_t           delta_t_s/ns are NOT removed - intervals are informative

--------------------------------------------------------------------------------

3. 32-NODE TRAINING CONFIGURATION

3.1 SLURM / Hardware Configuration

Parameter               Value                     Description
---------               -----                     -----------
--nodes                 32                        SLURM node count
--gres=gpu              4                         GPUs per node
Total GPUs              128                       32 x 4
GPU model               NVIDIA GH200 (sm_90a)     96 GB HBM3, Grace CPU
Available memory        ~85.5 GB / GPU            96 GB SKU
Intra-node interconnect NV6                       ~159 GB/s per GPU pair
Per-GPU bandwidth       ~478 GB/s                 18 NVLinks x 26.56 GB/s
Inter-node interconnect Slingshot                 HPE Cray
--time                  00:30:00 / 24:00:00       Test / Production limits
--ntasks-per-node       1                         1 process per node (4 GPUs)
Account                 brics.s5e                 Isambard-AI
Partition               workq                     Isambard-AI

3.2 Batch Size Configuration

Parameter               Value      Formula
---------               -----      -------
PER_GPU_BSZ             8          Env var, default 8
GPUS_PER_NODE           4          Fixed
NNODES                  32         SLURM
TOTAL_GPUS              128        32 x 4
GLOBAL_BSZ              1024       8 x 128
PER_PROCESS_BSZ         32         8 x 4 (DataLoader batch size)

3.3 Model Architecture (75M)

Parameter               Value                     Description
---------               -----                     -----------
d_model                 1024                      Hidden dimension H
n_layers                12                        Number of S5 blocks
n_message_layers        2                         Message encoder layers
n_book_pre_layers       1                         Order book pre-processing
n_book_post_layers      1                         Order book post-processing
blocks                  16                        SSM discretization blocks J
ssm_size_base           1024                      SSM latent state size P
block_size              64                        P / J = 1024 / 16
conj_sym                True                      Conjugate symmetry constraint
clip_eigs               True                      Force stability
bidirectional           False                     Unidirectional S5
activation_fn           half_glu1                 GLU variant
C_init                  trunc_standard_normal     Output initialization
discretization          zoh                       Zero-order hold
mode                    pool / none               Aggregation method
prenorm                 True                      Pre-LayerNorm
batchnorm               False                     Uses LayerNorm
Total params            ~75M
                                        |

3.4 Optimizer Configuration

Parameter       Value      Description
---------       ----       -----------
opt_config      standard   SSM params use Adam, others use AdamW
ssm_lr_base     5e-4       SSM param LR (B, Lambda, log_step, etc.)
lr_factor       1          Global LR = lr_factor x ssm_lr_base
Global LR       5e-4       For C, dense, encoder, etc.
weight_decay    0.05       Applies only to regular param group
p_dropout       0.0        No dropout
jax_seed        42         Random seed
LR schedule     optax      Computed inside JIT

3.5 Learning Rate Schedule

Phase                Formula                                       Steps                   Description
-----                -------                                       -----                   -----------
Warmup (linear)      lr = base x (step+1) / warmup                 1 epoch                 Linear ramp from 0 to 5e-4
Cosine Decay         lr = (base-min) x 0.5 x (1+cos(...)) + min    39 epochs               Decay from 5e-4 to 0
lr_min               0.0                                           -                       Lower bound

32-Node Specific Values:
Parameter            Value      Calculation
---------            -----      -----------
steps_per_epoch      ~549       train_size / (micro_bsz x num_devices x proc_count)
warmup_steps         ~549       1 epoch
cosine_steps         ~21,411    39 x 549
total_steps          ~21,960    40 x 549

3.6 Distributed Training / Sharding

Parameter              32N Value               Description
---------              ---------               -----------
Mesh type              2D (nodes, gpus)        Auto-enabled with hierarchical=True
Mesh shape             (32, 4)                 32 nodes x 4 GPUs
Data sharding          P((nodes,gpus), None)   Batch dim split across 128 GPUs
Param sharding         P() (replicated)        Each GPU holds full copy
Gradient sync          Hierarchical AllReduce  pmean(gpus) -> pmean(nodes)
Level 1 (NVLink)       jax.lax.pmean           Intra-node (4 GPUs), ~478 GB/s
Level 2 (Slingshot)    jax.lax.pmean           Across 32 nodes
shard_autotuning       False                   Avoids 16N scaling regression

3.7 NCCL Communication Configuration

Env Variable           Value              Description
------------           -----              -----------
NCCL_BUFFSIZE          2097152 (2MB)      Critical: 16N speedup from 34.8% to 83.3%
NCCL_TIMEOUT           3600 (1h)          Prevents false timeouts
NCCL_MIN_NCHANNELS     4                  Slingshot best practice
NCCL_NCHANNELS_PER_NET 4                  Isambard GH200 recommended
NCCL_DEBUG             INFO               Set to WARN after debugging
NCCL_P2P_DISABLE       0 (default)        Setting to 1 causes 25x slowdown

3.8 XLA / JAX Environment

Env Variable / Flag                         32N Value      Description
-------------------                         ---------      -----------
XLA_PYTHON_CLIENT_PREALLOCATE               true           GPU memory pooling
XLA_PYTHON_CLIENT_MEM_FRACTION              0.80           Dual NCCL communicator limit
JAX_PLATFORMS                               cuda           Force CUDA backend
TF_GPU_ALLOCATOR                            cuda_malloc    Async GPU memory
CUDA_MODULE_LOADING                         EAGER          Load modules at startup
--xla_gpu_all_reduce_combine_threshold      128MB          Combine AllReduce ops
--xla_gpu_enable_latency_hiding_scheduler   true           Overlap compute/comm
--xla_gpu_enable_highest_priority_async     true           High-priority streams
--xla_gpu_shard_autotuning                  false          Avoid autotuner overhead

3.9 Data Loading Configuration

