#!/bin/bash
#SBATCH --job-name=vocab-verify
#SBATCH --output=logs/vocab_verify_%j.out
#SBATCH --error=logs/vocab_verify_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --mem=64G
#SBATCH --time=00:30:00
#SBATCH --partition=workq

echo "============================================"
echo "Vocab验证: 原始 vs Perturbed Token"
echo "============================================"
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURMD_NODENAME"
echo "Start: $(date)"
echo "============================================"

cd /lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/LOBS5
source ~/miniforge3/etc/profile.d/conda.sh
conda activate lobs5

export PYTHONPATH="/lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/JaxMARL-HFT:$PYTHONPATH"
export XLA_PYTHON_CLIENT_PREALLOCATE=true
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
export JAX_PLATFORMS="cuda"
export PYTHONUNBUFFERED=1

nvidia-smi --query-gpu=name,memory.total --format=csv
echo ""

python -u -B test_vocab_verify.py

echo ""
echo "============================================"
echo "完成: $(date)"
echo "============================================"
