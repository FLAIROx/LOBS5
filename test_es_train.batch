#!/bin/bash
#SBATCH --job-name=es-test
#SBATCH --output=logs/es_test_%j.out
#SBATCH --error=logs/es_test_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:4
#SBATCH --mem=0
#SBATCH --time=00:30:00
#SBATCH --partition=workq

# ==============================================================================
# ES-LOBS5 Quick Test (30min)
# ==============================================================================
# Test the new run_es_train.py script with minimal epochs

echo "============================================"
echo "ES-LOBS5 Quick Test"
echo "============================================"
echo "Job ID:         $SLURM_JOB_ID"
echo "Node:           $SLURMD_NODENAME"
echo "Start time:     $(date)"
echo "Model Preset:   ${MODEL_PRESET:-L1}"
echo "============================================"

MODEL_PRESET=${MODEL_PRESET:-L1}
export MODEL_PRESET

mkdir -p logs
cd /lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/LOBS5

source ~/miniforge3/etc/profile.d/conda.sh
conda activate lobs5

export PYTHONPATH="/lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/JaxMARL-HFT:$PYTHONPATH"
export XLA_PYTHON_CLIENT_PREALLOCATE=true
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
export JAX_PLATFORMS="cuda"
export PYTHONUNBUFFERED=1

echo ""
echo "GPU Information:"
nvidia-smi --query-gpu=name,memory.total,memory.free --format=csv
echo ""

DATA_DIR="/lus/lfs1aip2/home/s5e/kangli.s5e/GOOG_GOOGL_2016TO2021_24tok_preproc/GOOG/2021"

echo "[*] Starting ES training test (5 epochs only)..."
echo ""

python -u -B run_es_train.py \
    --USE_WANDB=True \
    --wandb_entity=kang-oxford \
    --data_dir="$DATA_DIR" \
    --n_perturbations=1024 \
    --n_epochs=5 \
    --seed=42 \
    --max_training_hours=0.5

echo ""
echo "============================================"
echo "Test completed at: $(date)"
echo "============================================"
