#!/bin/bash
#SBATCH --job-name=lobs5_10node
#SBATCH --output=logs_lobs5_10node/lobs5_%j.out
#SBATCH --error=logs_lobs5_10node/lobs5_%j.err
# One task per node by default (override with CLI if needed)
#SBATCH --ntasks-per-node=1
# Request 4 GPUs per node by default (override with CLI if needed)
# Use GRES syntax for compatibility on this site
#SBATCH --gres=gpu:4
#SBATCH --mem=0

#SBATCH --nodes=10
#SBATCH --time=00:09:59
#SBATCH --contiguous  # 强制连续节点
#SBATCH --switches=1@00:15:00  # 尽量同一交换机

# ============================================
# Exclude problematic/slow nodes (41 nodes total)
# ============================================
# All DOWN/DRAIN/MAINTENANCE nodes from sinfo (Nov 24, 2024)
# Reasons: GPU failures, memory errors, network issues, maintenance, high load
#SBATCH --exclude=nid010016,nid010018,nid010019,nid010021,nid010038,nid010047,nid010050,nid010056,nid010143,nid010150,nid010151,nid010178,nid010306,nid010307,nid010326,nid010328,nid010345,nid010383,nid010400,nid010401,nid010538,nid010539,nid010540,nid010541,nid010578,nid010579,nid010660,nid010715,nid010798,nid010947,nid010948,nid010962,nid010963,nid010979,nid011042,nid011043,nid011082,nid011090,nid011210,nid011211,nid011231,nid011300


# ============================================
# LOBS5 10-Node Distributed Training Script (40 GPUs)
# ============================================
# Usage:
#   10-node (40 GPUs):   sbatch LOBS5/bin/run_experiments/isambard.batch
#   Custom nodes:        sbatch --nodes=N --time=HH:MM:SS LOBS5/bin/run_experiments/isambard.batch
# ============================================


# ============================================
# Environment Initialization
# ============================================

# Source conda
source ~/miniforge3/etc/profile.d/conda.sh

# Activate environment
conda activate lobs5

# Load CUDA module
module load cuda/12.6
module load gcc-native/13.2


# ============================================
# JAX Distributed Configuration
# ============================================

# Coordinator timeout (10 nodes need more time to initialize)
export JAX_COORDINATOR_TIMEOUT_MS=600000  # 10 minutes

# Reduce TensorFlow log spam
export TF_CPP_MIN_LOG_LEVEL=1

# JAX platforms priority
export JAX_PLATFORMS="cuda,cpu"

# GPU memory configuration
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.9
export XLA_PYTHON_CLIENT_PREALLOCATE=true


# ============================================
# NCCL Communication Optimization (Maximum Performance)
# ============================================

# Enable all hardware acceleration
export NCCL_DEBUG=WARN
export NCCL_IB_DISABLE=0                  # Enable InfiniBand
export NCCL_NET_GDR_LEVEL=3               # GPUDirect RDMA max level
export NCCL_P2P_DISABLE=0                 # Enable GPU P2P
export NCCL_P2P_DIRECT_DISABLE=0          # Enable Direct RDMA
export NCCL_SHM_DISABLE=0                 # Enable shared memory

# Isambard-AI specific optimizations (Slingshot network)
export NCCL_CROSS_NIC=1                   # Cross-NIC communication
export NCCL_SOCKET_IFNAME=^lo,docker      # Exclude loopback and docker

# GPU topology optimization
export CUDA_DEVICE_ORDER=PCI_BUS_ID


# ============================================
# CUDA Cache Configuration (Avoid ptxas errors)
# ============================================

if [ -n "$SLURM_TMPDIR" ]; then
    export TMPDIR="$SLURM_TMPDIR"
    export CUDA_CACHE_PATH="$SLURM_TMPDIR/.nv/ComputeCache"
else
    export CUDA_CACHE_PATH="$HOME/.nv/ComputeCache"
fi
mkdir -p "$CUDA_CACHE_PATH" || true


# ============================================
# JAX Coordinator Address Setup
# ============================================

# Calculate port (avoid conflicts)
export MASTER_PORT=$(expr 10000 + $(echo -n $SLURM_JOBID | tail -c 4))

# Get master node address
export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)

# Print configuration
echo "============================================"
echo "JAX Distributed Training Configuration"
echo "============================================"
echo "Nodes: $SLURM_NNODES"
echo "GPUs per node: 4"
echo "Total GPUs: $((SLURM_NNODES * 4))"
echo "Coordinator: ${MASTER_ADDR}:${MASTER_PORT}"
echo "Job ID: $SLURM_JOB_ID"
echo "Node list: $SLURM_JOB_NODELIST"
echo "============================================"

# Set LD_LIBRARY_PATH for JAX CUDA libraries (complete list from working environment)
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/cuda_nvrtc/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/cuda_runtime/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/cusparse/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/cuda_cupti/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/cufft/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/nvjitlink/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/cusolver/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/nccl/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/nvshmem/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/cublas/lib:$CONDA_PREFIX/lib/python3.11/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH


# ============================================
# Working Directory and Logs
# ============================================

cd /lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/LOBS5/
mkdir -p logs_lobs5_10node

# Clear caches (ignore errors)
find /lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/LOBS5 -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true
rm -rf ~/.cache/jax_cache 2>/dev/null || true
rm -rf /tmp/__pycache__/jax* 2>/dev/null || true
find . -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true
find . -name '*.pyc' -delete 2>/dev/null || true

# ============================================
# Launch Multi-Node Training (using srun)
# ============================================

# IMPORTANT: Remove the old XLA_FLAGS that forced 4 devices
# OLD: export XLA_FLAGS="--xla_force_host_platform_device_count=4"
# NEW: Let JAX auto-detect all GPUs across all nodes

# srun launches 40 processes (4 per node), each with 1 GPU
# Total: 10 nodes × 4 processes/node × 1 GPU/process = 40 GPUs
srun --nodes=$SLURM_NNODES \
     --ntasks=$((SLURM_NNODES * 4)) \
     --ntasks-per-node=4 \
     --gpus-per-task=1 \
     --gpu-bind=map_gpu:0,1,2,3 \
     bash /lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/LOBS5/bin/run_experiments/run_lobster_padded_large.sh