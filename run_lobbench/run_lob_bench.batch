#!/bin/bash
#SBATCH --job-name=lob_inference
#SBATCH --output=logs_lobs5/lob_inference_%j.out
#SBATCH --error=logs_lobs5/lob_inference_%j.err
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --mem=128G
#SBATCH --time=04:00:00

echo "============================================"
echo "LOB Inference Benchmark started at: $(date)"
echo "Job ID: $SLURM_JOB_ID"
echo "Running on node: $(hostname)"
echo "============================================"

cd /lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/LOBS5

# Source conda
source ~/miniforge3/etc/profile.d/conda.sh
conda activate lob

# Load CUDA module
module load cuda/12.6

# Set LD_LIBRARY_PATH for CUDA libs
export LD_LIBRARY_PATH=$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusparse/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cuda_cupti/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cufft/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nvjitlink/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cusolver/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/nccl/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cublas/lib:$CONDA_PREFIX/lib/python3.12/site-packages/nvidia/cudnn/lib:$LD_LIBRARY_PATH

# JAX environment
export XLA_PYTHON_CLIENT_PREALLOCATE=true
export XLA_PYTHON_CLIENT_MEM_FRACTION=0.85
export JAX_PLATFORMS=cuda,cpu  # Need both for DataLoader

# Paths for brisk-violet-111 checkpoint
CHECKPOINT_PATH="/lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/LOBS5/checkpoints/brisk-violet-111_x514rgnq"
DATA_DIR="/lus/lfs1aip2/home/s5e/kangli.s5e/GOOG_GOOGL_2016TO2021_24tok_preproc/GOOG/2022"
SAVE_DIR="/lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/lob_bench/output/brisk-violet-111"

echo "[*] Checkpoint: $CHECKPOINT_PATH"
echo "[*] Data Dir: $DATA_DIR"
echo "[*] Save Dir: $SAVE_DIR"
echo "[*] Available GPUs:"
nvidia-smi --list-gpus | head -1

# Create save directory if it doesn't exist
mkdir -p "$SAVE_DIR"

# Step 1: Run inference to generate predictions
# This will save data_gen, data_real, data_cond to $SAVE_DIR
echo "============================================"
echo "[Step 1] Running inference to generate data..."
echo "============================================"

$CONDA_PREFIX/bin/python -u run_inference.py \
  --stock=GOOG \
  --checkpoint_step=2 \
  --test_split=0.1 \
  --data_dir="$DATA_DIR" \
  --ckpt_path="$CHECKPOINT_PATH" \
  --save_dir="$SAVE_DIR"

INFERENCE_EXIT_CODE=$?

if [ $INFERENCE_EXIT_CODE -ne 0 ]; then
    echo "[ERROR] Inference failed with exit code $INFERENCE_EXIT_CODE"
    exit $INFERENCE_EXIT_CODE
fi

echo "============================================"
echo "[Step 1] Inference completed successfully"
echo "============================================"

# Step 2: Run benchmark to calculate L1 and Wasserstein distance
echo "============================================"
echo "[Step 2] Running benchmark scoring..."
echo "============================================"

cd /lus/lfs1aip2/home/s5e/kangli.s5e/AlphaTrade/lob_bench

$CONDA_PREFIX/bin/python -u run_bench.py \
  --data_dir="$SAVE_DIR" \
  --save_dir="$SAVE_DIR/results" \
  --model_name=s5 \
  --stock=GOOG \
  --time_period=2023

BENCH_EXIT_CODE=$?

if [ $BENCH_EXIT_CODE -ne 0 ]; then
    echo "[ERROR] Benchmark failed with exit code $BENCH_EXIT_CODE"
    exit $BENCH_EXIT_CODE
fi

echo "============================================"
echo "[Step 2] Benchmark completed successfully"
echo "Results saved to: $SAVE_DIR/results"
echo "============================================"

# Step 3: Generate plots
echo "============================================"
echo "[Step 3] Generating plots..."
echo "============================================"

$CONDA_PREFIX/bin/python -u run_plotting.py \
  --data_dir="$SAVE_DIR" \
  --save_dir="$SAVE_DIR/plots" \
  --model_name=s5 \
  --stock=GOOG \
  --time_period=2023

echo "============================================"
echo "LOB Benchmark completed at: $(date)"
echo "Plots saved to: $SAVE_DIR/plots"
echo "============================================"
