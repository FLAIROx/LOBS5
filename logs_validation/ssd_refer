  # === SSD-style block scan (equivalent to apply_ssm) ===

  def _ssd_block_scan(Lambda_bar, Bu_block, h0):
      """
      Lambda_bar: (P,) complex64
      Bu_block:   (K, P) complex64
      h0:         (P,) complex64 (block entry state)
      Returns:
        h_out: (P,)
        xs_block: (K, P)
      """
      P = Lambda_bar.shape[0]
      # Broadcast A for this block only (K,P)
      Lambda_block = np.broadcast_to(Lambda_bar, Bu_block.shape)
      # Inject h0 by prepending A=1, b=h0
      Lambda_block = np.concatenate(
          [np.ones((1, P), dtype=Lambda_bar.dtype), Lambda_block],
          axis=0,
      )
      Bu_block = np.concatenate([h0[None], Bu_block], axis=0)

      _, xs = jax.lax.associative_scan(binary_operator, (Lambda_block, Bu_block))
      xs = xs[1:]           # drop injected h0
      h_out = xs[-1]
      return h_out, xs


  def apply_ssm_ssd(Lambda_bar, B_bar, C_tilde, input_sequence,
                    conj_sym, bidirectional, block_size=256):
      """
      SSD-style block scan (math equivalent to apply_ssm).
      block_size: K (e.g. 128/256/512)
      """

      # === Step 1: B@u (same as apply_ssm) ===
      input_fp32 = input_sequence.astype(np.float32)
      input_T = input_fp32.T.astype(np.bfloat16)  # (H, L)
      B_re = B_bar.real.astype(np.bfloat16)       # (P, H)
      B_im = B_bar.imag.astype(np.bfloat16)       # (P, H)

      Bu_re = np.matmul(B_re, input_T)  # (P, L)
      Bu_im = np.matmul(B_im, input_T)  # (P, L)
      Bu = (Bu_re.astype(np.float32) + 1j * Bu_im.astype(np.float32)).T  # (L, P)

      # === Step 2: block scan ===
      L, P = Bu.shape
      n_blocks = (L + block_size - 1) // block_size
      pad = n_blocks * block_size - L
      if pad > 0:
          Bu = np.pad(Bu, ((0, pad), (0, 0)))

      Bu_blocks = Bu.reshape(n_blocks, block_size, P)
      h0 = np.zeros((P,), dtype=Bu.dtype)

      def body(h, Bu_block):
          h_out, xs_block = _ssd_block_scan(Lambda_bar, Bu_block, h)
          return h_out, xs_block

      _, xs_blocks = jax.lax.scan(body, h0, Bu_blocks)
      xs = xs_blocks.reshape(n_blocks * block_size, P)[:L]

      # === Bidirectional (match associative_scan(reverse=True)) ===
      if bidirectional:
          Bu_rev = Bu[:L][::-1]
          if pad > 0:
              Bu_rev = np.pad(Bu_rev, ((0, pad), (0, 0)))
          Bu_rev_blocks = Bu_rev.reshape(n_blocks, block_size, P)

          _, xs_rev_blocks = jax.lax.scan(body, h0, Bu_rev_blocks)
          xs_rev = xs_rev_blocks.reshape(n_blocks * block_size, P)[:L]
          xs_rev = xs_rev[::-1]  # reverse back to original order
          xs = np.concatenate((xs, xs_rev), axis=-1)

      # === Step 3: C@x (same as apply_ssm) ===
      xs_T = xs.T
      C_re = C_tilde.real.astype(np.bfloat16)
      C_im = C_tilde.imag.astype(np.bfloat16)
      xs_re = xs_T.real.astype(np.bfloat16)
      xs_im = xs_T.imag.astype(np.bfloat16)

      ys_re = np.matmul(C_re, xs_re) - np.matmul(C_im, xs_im)
      ys = (2 * ys_re if conj_sym else ys_re).T.astype(np.float32)
      return ys

