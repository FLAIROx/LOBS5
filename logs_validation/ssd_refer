      _, xs = jax.lax.associative_scan(binary_operator, (Lambda_block, Bu_block))
      xs = xs[1:]
      h_out = xs[-1]
      return h_out, xs


  def apply_ssm_ssd_packed(Lambda_bar, B_bar, C_tilde, input_sequence,
                           conj_sym, bidirectional, block_size=256):
      """
      SSD block scan + packed GEMM for complex parts (equivalent).
      """

      # === Step 1: B@u with packed GEMM ===
      input_fp32 = input_sequence.astype(np.float32)
      input_T = input_fp32.T.astype(np.bfloat16)  # (H, L)

      # Stack B_re and B_im into one GEMM: (2P, H) @ (H, L) -> (2P, L)
      B_re = B_bar.real.astype(np.bfloat16)
      B_im = B_bar.imag.astype(np.bfloat16)
      B_pack = np.concatenate([B_re, B_im], axis=0)   # (2P, H)

      Bu_pack = np.matmul(B_pack, input_T)            # (2P, L) BF16
      Bu_re = Bu_pack[:B_re.shape[0]]
      Bu_im = Bu_pack[B_re.shape[0]:]

      Bu = (Bu_re.astype(np.float32) + 1j * Bu_im.astype(np.float32)).T  # (L, P)

      # === Step 2: SSD block scan ===
      L, P = Bu.shape
      n_blocks = (L + block_size - 1) // block_size
      pad = n_blocks * block_size - L
      if pad > 0:
          Bu = np.pad(Bu, ((0, pad), (0, 0)))

      Bu_blocks = Bu.reshape(n_blocks, block_size, P)
      h0 = np.zeros((P,), dtype=Bu.dtype)

      def body(h, Bu_block):
          h_out, xs_block = _ssd_block_scan(Lambda_bar, Bu_block, h)
          return h_out, xs_block

      _, xs_blocks = jax.lax.scan(body, h0, Bu_blocks)
      xs = xs_blocks.reshape(n_blocks * block_size, P)[:L]

      if bidirectional:
          Bu_rev = Bu[:L][::-1]
          if pad > 0:
              Bu_rev = np.pad(Bu_rev, ((0, pad), (0, 0)))
          Bu_rev_blocks = Bu_rev.reshape(n_blocks, block_size, P)

          _, xs_rev_blocks = jax.lax.scan(body, h0, Bu_rev_blocks)
          xs_rev = xs_rev_blocks.reshape(n_blocks * block_size, P)[:L]
          xs_rev = xs_rev[::-1]
          xs = np.concatenate((xs, xs_rev), axis=-1)

      # === Step 3: C@x (real part only) with packed GEMM ===
      xs_T = xs.T  # (P, L)
      xs_re = xs_T.real.astype(np.bfloat16)
      xs_im = xs_T.imag.astype(np.bfloat16)

      # Real(C @ x) = [C_re, -C_im] @ [x_re; x_im]
      C_re = C_tilde.real.astype(np.bfloat16)  # (H, P)
      C_im = C_tilde.imag.astype(np.bfloat16)  # (H, P)
      C_pack = np.concatenate([C_re, -C_im], axis=1)  # (H, 2P)
      xs_pack = np.concatenate([xs_re, xs_im], axis=0)  # (2P, L)

      ys_re = np.matmul(C_pack, xs_pack)  # (H, L) BF16
      ys = (2 * ys_re if conj_sym else ys_re).T.astype(np.float32)
      return ys

