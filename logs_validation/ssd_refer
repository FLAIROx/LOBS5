  (a+ib)(x_r+i x_i) \equiv
  \begin{bmatrix} a & -b \ b & a \end{bmatrix}
  \begin{bmatrix} x_r \ x_i \end{bmatrix}
  ]

  ———

  ## 2. SSM/SSD 更新的等价形式（实块版）

  原复数递推：
  [
  x_t = \Lambda x_{t-1} + B u_t
  ]

  等价的实块递推（每个模式都变 2 通道）：
  [
  \begin{bmatrix} x^r_t \ x^i_t \end{bmatrix}

  \begin{bmatrix} \Lambda_r & -\Lambda_i \ \Lambda_i & \Lambda_r \end{bmatrix}
  \begin{bmatrix} x^r_{t-1} \ x^i_{t-1} \end{bmatrix}
  +
  \begin{bmatrix} B_r & -B_i \ B_i & B_r \end{bmatrix} u_t
  ]

  输出（实输出）：
  [
  y_t = \Re(C x_t)= [C_r, -C_i]\begin{bmatrix} x^r_t \ x^i_t \end{bmatrix}
  ]

  输出（复输出）：
  [
  \begin{bmatrix} y^r \ y^i \end{bmatrix}

  \begin{bmatrix} C_r & -C_i \ C_i & C_r \end{bmatrix}
  \begin{bmatrix} x^r \ x^i \end{bmatrix}
  ]

  ———

  ## 3. 离散化也严格等价

  你用的任何解析函数（exp、ZOH、bilinear）都满足：
  [
  f(a+ib)\ \leftrightarrow\
  \begin{bmatrix}\Re f & -\Im f\ \Im f & \Re f\end{bmatrix}
  ]

  - 先在 complex 上算 exp，再映射到 2×2
  - 或 直接在 2×2 实块上算 exp
    两者数学等价，只是浮点舍入顺序不同。

  ———

  ## 4. 直接可用的等价实现（关键公式代码）

  import jax.numpy as jnp

  def c_mul(a_re, a_im, b_re, b_im):
      return a_re*b_re - a_im*b_im, a_re*b_im + a_im*b_re

  def real2x2_apply(lam_re, lam_im, x_re, x_im):
      # [a -b; b a] * [x_re; x_im]
      out_re = lam_re * x_re - lam_im * x_im
      out_im = lam_im * x_re + lam_re * x_im
      return out_re, out_im

  def pack_B_real2(B_re, B_im):
      # (P,H) -> (2P,H), 等价于复数 B
      return jnp.concatenate([B_re, B_im], axis=0)

  def pack_C_real2(C_re, C_im):
      # (H,P) -> (H,2P), 实输出
      return jnp.concatenate([C_re, -C_im], axis=1)

  def apply_ssm_real2(lam_re, lam_im, B_re, B_im, C_re, C_im, D, u):
      # u: (L,H)
      u_T = u.T  # (H,L)

      # B@u (real2)
      B_pack = pack_B_real2(B_re, B_im)   # (2P,H)
      Bu = B_pack @ u_T                   # (2P,L)
      P = Bu.shape[0] // 2
      bu_re, bu_im = Bu[:P], Bu[P:]

      # scan: x_t = lam * x_{t-1} + bu_t
      # 这里省略 scan 的实现，只强调等价性

      # C@x (real output)
      C_pack = pack_C_real2(C_re, C_im)  # (H,2P)
      x_pack = jnp.concatenate([xs_re, xs_im], axis=1).T  # (2P,L)
      y = (C_pack @ x_pack).T  # (L,H)

      return y + u * D[None, :]

