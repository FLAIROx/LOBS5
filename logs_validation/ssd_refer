  def apply_ssm_rnn_ssd(Lambda_bar, B_bar, C_tilde, hidden, input_sequence,
                        resets, conj_sym, bidirectional, block_size=256):
      """
      SSD-style block scan RNN version (equivalent to apply_ssm_rnn).
      """
      if bidirectional:
          raise ValueError("Cannot expect a bidirectional view if doing rnn")

      input_fp32 = input_sequence.astype(np.float32)

      # === B@u ===
      input_T = input_fp32.T.astype(np.bfloat16)
      B_re = B_bar.real.astype(np.bfloat16)
      B_im = B_bar.imag.astype(np.bfloat16)
      Bu_re = np.matmul(B_re, input_T)
      Bu_im = np.matmul(B_im, input_T)
      Bu = (Bu_re.astype(np.float32) + 1j * Bu_im.astype(np.float32)).T  # (L,P)

      # === prepend hidden ===
      Bu = np.concatenate([hidden, Bu], axis=0)

      # === block scan ===
      L, P = Bu.shape
      n_blocks = (L + block_size - 1) // block_size
      pad = n_blocks * block_size - L
      if pad > 0:
          Bu = np.pad(Bu, ((0, pad), (0, 0)))

      Bu_blocks = Bu.reshape(n_blocks, block_size, P)

      # initial h0 = 0 (hidden already prepended)
      h0 = np.zeros((P,), dtype=Bu.dtype)

      def body(h, Bu_block):
          h_out, xs_block = _ssd_block_scan(Lambda_bar, Bu_block, h)
          return h_out, xs_block

      _, xs_blocks = jax.lax.scan(body, h0, Bu_blocks)
      xs = xs_blocks.reshape(n_blocks * block_size, P)[:L]

      # Extract hidden state (first element corresponds to prepended hidden)
      hidden_out = xs[np.newaxis, 0]
      xs = xs[1:]

      # === C@x ===
      C_re = C_tilde.real.astype(np.bfloat16)
      C_im = C_tilde.imag.astype(np.bfloat16)
      xs_re = xs_T.real.astype(np.bfloat16)
      xs_im = xs_T.imag.astype(np.bfloat16)

      ys_re = np.matmul(C_re, xs_re) - np.matmul(C_im, xs_im)
      ys = (2 * ys_re if conj_sym else ys_re).T.astype(np.float32)
      return hidden_out, ys

