  # s5/ssd_fused_triton.py
  # Triton-only fused kernel: B@u + scan + C@x
  # No forward fallback is allowed.

  from __future__ import annotations

  from functools import partial
  import jax
  import jax.numpy as jnp

  try:
      import triton
      import triton.language as tl
      import jax_triton as jt
  except Exception as exc:
      raise RuntimeError("Triton is required. No fallback is allowed.") from exc


  def _cmul(re1, im1, re2, im2):
      return re1 * re2 - im1 * im2, re1 * im2 + im1 * re2


  def _ssd_reference(u, B_re, B_im, C_re, C_im, lam_re, lam_im):
      # Reference SSD forward (for backward vjp only)
      # u: (L,H), B: (P,H), C: (H,P), lam: (P,)
      L, H = u.shape
      P = B_re.shape[0]

      Bu_re = jnp.matmul(B_re, u.T).T  # (L,P)
      Bu_im = jnp.matmul(B_im, u.T).T

      def scan_op(carry, inp):
          x_re, x_im = carry
          b_re, b_im = inp
          x_re, x_im = _cmul(lam_re, lam_im, x_re, x_im)
          x_re = x_re + b_re
          x_im = x_im + b_im
          return (x_re, x_im), (x_re, x_im)

      (x_re, x_im), xs = jax.lax.scan(scan_op, (jnp.zeros((P,)), jnp.zeros((P,))), (Bu_re, Bu_im))
      x_re_seq, x_im_seq = xs  # (L,P)

      y_re = jnp.matmul(C_re, x_re_seq.T).T - jnp.matmul(C_im, x_im_seq.T).T
      y_im = jnp.matmul(C_re, x_im_seq.T).T + jnp.matmul(C_im, x_re_seq.T).T
      return y_re, y_im


  @triton.jit
  def _ssd_summary_kernel(
      u_ptr, b_re_ptr, b_im_ptr, lam_re_ptr, lam_im_ptr, out_ptr,
      L, H, P, N_BLOCKS,
      BLOCK_M: tl.constexpr, BLOCK_P: tl.constexpr, BLOCK_K: tl.constexpr
  ):
      pid_p = tl.program_id(0)
      pid_blk = tl.program_id(1)

      p_idx = pid_p * BLOCK_P + tl.arange(0, BLOCK_P)
      mask_p = p_idx < P

      lam_re = tl.load(lam_re_ptr + p_idx, mask=mask_p, other=1.0).to(tl.float32)
      lam_im = tl.load(lam_im_ptr + p_idx, mask=mask_p, other=0.0).to(tl.float32)

      a_prod_re = tl.full([BLOCK_P], 1.0, tl.float32)
      a_prod_im = tl.zeros([BLOCK_P], tl.float32)
      x_re = tl.zeros([BLOCK_P], tl.float32)
      x_im = tl.zeros([BLOCK_P], tl.float32)

      for i in range(BLOCK_M):
          t = pid_blk * BLOCK_M + i
          in_range = t < L

          # Bu = B @ u_t  (u_t is real)
          bu_re = tl.zeros([BLOCK_P], tl.float32)
          bu_im = tl.zeros([BLOCK_P], tl.float32)

          for k in range(0, H, BLOCK_K):
              k_idx = tl.arange(0, BLOCK_K)
              mask_k = k_idx < H

              b_re = tl.load(b_re_ptr + p_idx[:, None] * H + (k + k_idx[None, :]),
                             mask=mask_p[:, None] & mask_k[None, :], other=0.0).to(tl.float32)
              b_im = tl.load(b_im_ptr + p_idx[:, None] * H + (k + k_idx[None, :]),
                             mask=mask_p[:, None] & mask_k[None, :], other=0.0).to(tl.float32)

              if in_range:
                  u = tl.load(u_ptr + t * H + (k + k_idx), mask=mask_k, other=0.0).to(tl.float32)
              else:
                  u = tl.zeros([BLOCK_K], tl.float32)

              bu_re += tl.sum(b_re * u[None, :], axis=1)
              bu_im += tl.sum(b_im * u[None, :], axis=1)

          # x = lam * x + bu
          tmp_re = lam_re * x_re - lam_im * x_im
          tmp_im = lam_re * x_im + lam_im * x_re
          x_re = tmp_re + bu_re
          x_im = tmp_im + bu_im

          # a_prod = lam * a_prod
          tmp_re = lam_re * a_prod_re - lam_im * a_prod_im
          tmp_im = lam_re * a_prod_im + lam_im * a_prod_re
          a_prod_re = tmp_re
          a_prod_im = tmp_im

      base = pid_blk * P + p_idx
      stride0 = N_BLOCKS * P
      tl.store(out_ptr + 0 * stride0 + base, a_prod_re, mask=mask_p)
      tl.store(out_ptr + 1 * stride0 + base, a_prod_im, mask=mask_p)
      tl.store(out_ptr + 2 * stride0 + base, x_re, mask=mask_p)
      tl.store(out_ptr + 3 * stride0 + base, x_im, mask=mask_p)


  @triton.jit
  def _ssd_fused_apply_kernel(
      u_ptr, b_re_ptr, b_im_ptr, c_re_ptr, c_im_ptr,
      lam_re_ptr, lam_im_ptr, x0_re_ptr, x0_im_ptr,
      out_re_ptr, out_im_ptr,
      L, H, P, N_BLOCKS,
      BLOCK_M: tl.constexpr, BLOCK_P: tl.constexpr, BLOCK_H: tl.constexpr, BLOCK_K: tl.constexpr
  ):
      pid_h = tl.program_id(0)
      pid_blk = tl.program_id(1)

      h_idx = pid_h * BLOCK_H + tl.arange(0, BLOCK_H)
      mask_h = h_idx < H

      # output tile: [BLOCK_M, BLOCK_H]
      y_re = tl.zeros([BLOCK_M, BLOCK_H], tl.float32)
      y_im = tl.zeros([BLOCK_M, BLOCK_H], tl.float32)

      for p_off in range(0, P, BLOCK_P):
          p_idx = p_off + tl.arange(0, BLOCK_P)
          mask_p = p_idx < P

          lam_re = tl.load(lam_re_ptr + p_idx, mask=mask_p, other=1.0).to(tl.float32)
          lam_im = tl.load(lam_im_ptr + p_idx, mask=mask_p, other=0.0).to(tl.float32)

          # x0 for this block and P tile
          x_re = tl.load(x0_re_ptr + pid_blk * P + p_idx, mask=mask_p, other=0.0).to(tl.float32)
          x_im = tl.load(x0_im_ptr + pid_blk * P + p_idx, mask=mask_p, other=0.0).to(tl.float32)

          # load C tile once: (H_blk, P_blk)
          c_re = tl.load(c_re_ptr + h_idx[:, None] * P + p_idx[None, :],
                         mask=mask_h[:, None] & mask_p[None, :], other=0.0).to(tl.float32)
          c_im = tl.load(c_im_ptr + h_idx[:, None] * P + p_idx[None, :],
                         mask=mask_h[:, None] & mask_p[None, :], other=0.0).to(tl.float32)

          # load B tile once: (P_blk, H)
          # B is used to compute Bu for each t
          # We'll load by K-tiles
          for t_off in range(BLOCK_M):
              t = pid_blk * BLOCK_M + t_off
              in_range = t < L

              # Bu = B @ u_t
              bu_re = tl.zeros([BLOCK_P], tl.float32)
              bu_im = tl.zeros([BLOCK_P], tl.float32)

              for k in range(0, H, BLOCK_K):
                  k_idx = tl.arange(0, BLOCK_K)
                  mask_k = k_idx < H

                  b_re = tl.load(b_re_ptr + p_idx[:, None] * H + (k + k_idx[None, :]),
                                 mask=mask_p[:, None] & mask_k[None, :], other=0.0).to(tl.float32)
                  b_im = tl.load(b_im_ptr + p_idx[:, None] * H + (k + k_idx[None, :]),
                                 mask=mask_p[:, None] & mask_k[None, :], other=0.0).to(tl.float32)

                  if in_range:
                      u = tl.load(u_ptr + t * H + (k + k_idx), mask=mask_k, other=0.0).to(tl.float32)
                  else:
                      u = tl.zeros([BLOCK_K], tl.float32)

                  bu_re += tl.sum(b_re * u[None, :], axis=1)
                  bu_im += tl.sum(b_im * u[None, :], axis=1)

              # x = lam * x + bu
              tmp_re = lam_re * x_re - lam_im * x_im
              tmp_im = lam_re * x_im + lam_im * x_re
              x_re = tmp_re + bu_re
              x_im = tmp_im + bu_im

              # y += C @ x
              # y_re = C_re @ x_re - C_im @ x_im
              # y_im = C_re @ x_im + C_im @ x_re
              y_re_t = tl.sum(c_re * x_re[None, :], axis=1) - tl.sum(c_im * x_im[None, :], axis=1)
              y_im_t = tl.sum(c_re * x_im[None, :], axis=1) + tl.sum(c_im * x_re[None, :], axis=1)

              # accumulate for this time
              y_re = tl.where(tl.arange(0, BLOCK_M) == t_off, y_re + y_re_t[None, :], y_re)
              y_im = tl.where(tl.arange(0, BLOCK_M) == t_off, y_im + y_im_t[None, :], y_im)

      # store output
      for t_off in range(BLOCK_M):
          t = pid_blk * BLOCK_M + t_off
          if t < L:
              tl.store(out_re_ptr + t * H + h_idx, y_re[t_off, :], mask=mask_h)
              tl.store(out_im_ptr + t * H + h_idx, y_im[t_off, :], mask=mask_h)


  def _ssd_fused_triton_impl(u, B_re, B_im, C_re, C_im, lam_re, lam_im,
                             block_m=32, block_p=64, block_h=64, block_k=32):
      if u.ndim != 2:
          raise ValueError("u must be 2D (L,H)")
      L, H = u.shape
      P = B_re.shape[0]

      L_pad = ((L + block_m - 1) // block_m) * block_m
      n_blocks = L_pad // block_m

      if L_pad != L:
          pad = L_pad - L
          u = jnp.pad(u, ((0, pad), (0, 0)), mode="constant", constant_values=0.0)

      grid_summary = ((P + block_p - 1) // block_p, n_blocks)
      summary_shape = jax.ShapeDtypeStruct((4, n_blocks, P), jnp.float32)
      summary = jt.triton_call(
          u, B_re, B_im, lam_re, lam_im,
          kernel=_ssd_summary_kernel,
          out_shape=summary_shape,
          grid=grid_summary,
          L=L_pad, H=H, P=P, N_BLOCKS=n_blocks,
          BLOCK_M=block_m, BLOCK_P=block_p, BLOCK_K=block_k,
      )

      a_prod_re = summary[0]
      a_prod_im = summary[1]
      b_end_re = summary[2]
      b_end_im = summary[3]

      # block prefix scan (JAX)
      def binary_op(x, y):
          a1_re, a1_im, b1_re, b1_im = x
          a2_re, a2_im, b2_re, b2_im = y
          a_re_o, a_im_o = _cmul(a2_re, a2_im, a1_re, a1_im)
          t_re, t_im = _cmul(a2_re, a2_im, b1_re, b1_im)
          b_re_o = b2_re + t_re
          b_im_o = b2_im + t_im
          return (a_re_o, a_im_o, b_re_o, b_im_o)

      _, _, x_end_re, x_end_im = jax.lax.associative_scan(
          binary_op, (a_prod_re, a_prod_im, b_end_re, b_end_im)
      )

      zero = jnp.zeros((1, P), dtype=jnp.float32)
      x0_re = jnp.concatenate([zero, x_end_re[:-1]], axis=0)
      x0_im = jnp.concatenate([zero, x_end_im[:-1]], axis=0)

      out_re = jnp.empty((L_pad, H), dtype=jnp.float32)
      out_im = jnp.empty((L_pad, H), dtype=jnp.float32)

      grid_apply = ((H + block_h - 1) // block_h, n_blocks)
      _ = jt.triton_call(
          u, B_re, B_im, C_re, C_im, lam_re, lam_im, x0_re, x0_im,
          out_re, out_im,
          kernel=_ssd_fused_apply_kernel,
          out_shape=(out_re, out_im),
          grid=grid_apply,
          L=L_pad, H=H, P=P, N_BLOCKS=n_blocks,
          BLOCK_M=block_m, BLOCK_P=block_p, BLOCK_H=block_h, BLOCK_K=block_k,
      )

      return out_re[:L], out_im[:L]


