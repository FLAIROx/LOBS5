  def discretize_bilinear(Lambda, B_tilde, Delta):
      """Bilinear discretization for diagonal SSM."""
      identity = np.ones(Lambda.shape[0])
      BL = 1.0 / (identity - (Delta / 2.0) * Lambda)
      Lambda_bar = BL * (identity + (Delta / 2.0) * Lambda)
      B_bar = (BL * Delta)[..., None] * B_tilde
      return Lambda_bar, B_bar


  def discretize_zoh(Lambda, B_tilde, Delta):
      """Zero-order-hold discretization for diagonal SSM."""
      identity = np.ones(Lambda.shape[0])
      Lambda_bar = np.exp(Lambda * Delta)
      B_bar = (1.0 / Lambda * (Lambda_bar - identity))[..., None] * B_tilde
      return Lambda_bar, B_bar


  def _binary_operator(q_i, q_j):
      """Associative operator for diagonal SSM scan."""
      A_i, b_i = q_i
      A_j, b_j = q_j
      return A_j * A_i, A_j * b_i + b_j


  def _pack_complex_matmul_real_input(B_re, B_im, x_T_bf16):
      """Compute (B_re + i*B_im) @ x using one GEMM (packed)."""
      B_pack = np.concatenate([B_re, B_im], axis=0)  # (2P, H)
      out_pack = np.matmul(B_pack, x_T_bf16)  # (2P, L)
      Bu_re, Bu_im = np.split(out_pack, 2, axis=0)
      return Bu_re, Bu_im


  def _pack_complex_matmul_real_output(C_re, C_im, x_re, x_im):
      """Compute Re((C_re + i*C_im) @ (x_re + i*x_im)) using one GEMM."""
      C_pack = np.concatenate([C_re, -C_im], axis=1)  # (H, 2P)
      x_pack = np.concatenate([x_re, x_im], axis=0)   # (2P, L)
      ys_re = np.matmul(C_pack, x_pack)
      return ys_re


  def _ssd_block_scan(Lambda_bar, Bu, block_len):
      """Block-wise scan (SSD-style). Returns x[t] for all t.

      Bu: (L, P) complex64
      Lambda_bar: (P,) complex64
      """
      L, P = Bu.shape
      if block_len <= 0:
          raise ValueError("block_len must be > 0")

      num_blocks = (L + block_len - 1) // block_len
      pad_len = num_blocks * block_len - L
      if pad_len:
          pad = np.zeros((pad_len, P), dtype=Bu.dtype)
          Bu = np.concatenate([Bu, pad], axis=0)

      Bu_blocks = Bu.reshape(num_blocks, block_len, P)

      # Lambda powers: Lambda^(1..K)
      Lambda_pow = np.cumprod(np.broadcast_to(Lambda_bar, (block_len, P)), axis=0)
      A_block = np.broadcast_to(Lambda_bar, (block_len, P))

      def scan_block(bu_block, lambda_bar):
          A_local = A_block
          _, xs_block = jax.lax.associative_scan(_binary_operator, (A_local, bu_block))
          return xs_block

      x_intra = jax.vmap(scan_block, in_axes=(0, None))(Bu_blocks, Lambda_bar)
      b_block = x_intra[:, -1, :]
      A_block_full = Lambda_pow[-1]  # Lambda^K
      A_blocks = np.broadcast_to(A_block_full, (num_blocks, P))

      # Prefix over blocks to get block end states
      _, x_end = jax.lax.associative_scan(_binary_operator, (A_blocks, b_block))

      x_prev = np.concatenate(
          [np.zeros((1, P), dtype=Bu.dtype), x_end[:-1]],
          axis=0,
      )
      x_out_blocks = x_intra + Lambda_pow[None, :, :] * x_prev[:, None, :]
      x_out = x_out_blocks.reshape(num_blocks * block_len, P)
      if pad_len:
          x_out = x_out[:L]
      return x_out


