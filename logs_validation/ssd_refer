          pid_b = tl.program_id(0)
          pid_p = tl.program_id(1)

          p_offsets = pid_p * BLOCK_P + tl.arange(0, BLOCK_P)
          mask_p = p_offsets < P

          pref_re = tl.load(prefix_re_ptr + pid_b * P + p_offsets, mask=mask_p, other=0.0)
          pref_im = tl.load(prefix_im_ptr + pid_b * P + p_offsets, mask=mask_p, other=0.0)

          base_t = pid_b * BLOCK_T
          for t in range(BLOCK_T):
              idx = (base_t + t) * P + p_offsets

              x_re = tl.load(x_intra_re_ptr + idx, mask=mask_p, other=0.0)
              x_im = tl.load(x_intra_im_ptr + idx, mask=mask_p, other=0.0)

              lam_re = tl.load(lam_pow_re_ptr + t * P + p_offsets, mask=mask_p, other=0.0)
              lam_im = tl.load(lam_pow_im_ptr + t * P + p_offsets, mask=mask_p, other=0.0)

              add_re = lam_re * pref_re - lam_im * pref_im
              add_im = lam_re * pref_im + lam_im * pref_re

              out_re = x_re + add_re
              out_im = x_im + add_im

              tl.store(x_out_re_ptr + idx, out_re, mask=mask_p)
              tl.store(x_out_im_ptr + idx, out_im, mask=mask_p)


  def _ssd_scan_triton_impl(lam_re, lam_im, bu_re, bu_im, block_len):
      if not TRITON_AVAILABLE:
          raise RuntimeError("Triton not available")

      L, P = bu_re.shape
      num_blocks = (L + block_len - 1) // block_len
      L_pad = num_blocks * block_len
      pad_len = L_pad - L

      if pad_len:
          pad = np.zeros((pad_len, P), dtype=bu_re.dtype)
          bu_re = np.concatenate([bu_re, pad], axis=0)
          bu_im = np.concatenate([bu_im, pad], axis=0)

      BLOCK_P = 128
      grid = lambda meta: (num_blocks, triton.cdiv(P, meta["BLOCK_P"]))

      x_intra_re, x_intra_im = jt.triton_call(
          bu_re, bu_im, lam_re, lam_im,
          kernel=_ssd_intra_kernel,
          out_shape=(
              jax.ShapeDtypeStruct((L_pad, P), np.float32),
              jax.ShapeDtypeStruct((L_pad, P), np.float32),
          ),
          grid=grid,
          L=L_pad, P=P,
          BLOCK_T=block_len,
          BLOCK_P=BLOCK_P,
          num_warps=4,
          num_stages=2,
      )

      # compute block ends (JAX)
      x_intra_re_blocks = x_intra_re.reshape(num_blocks, block_len, P)
      x_intra_im_blocks = x_intra_im.reshape(num_blocks, block_len, P)
      x_end_re = x_intra_re_blocks[:, -1, :]
      x_end_im = x_intra_im_blocks[:, -1, :]

      # prefix states across blocks (JAX)
      lam_c = lam_re + 1j * lam_im
      lam_pow = np.cumprod(np.broadcast_to(lam_c, (block_len, P)), axis=0)
      A_blocks = np.broadcast_to(lam_pow[-1], (num_blocks, P))
      b_blocks = x_end_re + 1j * x_end_im
      _, x_end = jax.lax.associative_scan(_binary_operator, (A_blocks, b_blocks))
      x_prefix = np.concatenate([np.zeros((1, P), x_end.dtype), x_end[:-1]], axis=0)

      prefix_re = x_prefix.real.astype(np.float32)
      prefix_im = x_prefix.imag.astype(np.float32)
      lam_pow_re = lam_pow.real.astype(np.float32)
      lam_pow_im = lam_pow.imag.astype(np.float32)

      x_out_re, x_out_im = jt.triton_call(
          x_intra_re, x_intra_im,
          prefix_re, prefix_im,
          lam_pow_re, lam_pow_im,
          kernel=_ssd_apply_prefix_kernel,
          out_shape=(
              jax.ShapeDtypeStruct((L_pad, P), np.float32),
              jax.ShapeDtypeStruct((L_pad, P), np.float32),
          ),
          grid=grid,
          L=L_pad, P=P,
          BLOCK_T=block_len,
          BLOCK_P=BLOCK_P,
          num_warps=4,
          num_stages=2,
      )

      if pad_len:
          x_out_re = x_out_re[:L]
          x_out_im = x_out_im[:L]

      return x_out_re, x_out_im


  @partial(jax.custom_vjp, nondiff_argnums=(4,))
  def ssd_scan_triton(lam_re, lam_im, bu_re, bu_im, block_len):
      return _ssd_scan_triton_impl(lam_re, lam_im, bu_re, bu_im, block_len)


  def _ssd_scan_triton_fwd(lam_re, lam_im, bu_re, bu_im, block_len):
      x_re, x_im = _ssd_scan_triton_impl(lam_re, lam_im, bu_re, bu_im, block_len)
      return (x_re, x_im), (lam_re, lam_im, bu_re, bu_im)


  def _ssd_scan_triton_bwd(block_len, res, g):
      lam_re, lam_im, bu_re, bu_im = res
      g_re, g_im = g

      def ref_fn(lr, li, br, bi):
          lam_c = lr + 1j * li
          bu_c = br + 1j * bi
          x_c = _ssd_block_scan_jax(lam_c, bu_c, block_len)
          return (x_c.real, x_c.imag)

      (_, _), vjp_fn = jax.vjp(ref_fn, lam_re, lam_im, bu_re, bu_im)
      d_lam_re, d_lam_im, d_bu_re, d_bu_im = vjp_fn((g_re, g_im))
      return d_lam_re, d_lam_im, d_bu_re, d_bu_im


  ssd_scan_triton.defvjp(_ssd_scan_triton_fwd, _ssd_scan_triton_bwd)


  # -----------------------------------------------------------------------------
  # SSD apply (complex)
  # -----------------------------------------------------------------------------
  def apply_ssd(Lambda_bar, B_bar, C_tilde,
                input_sequence, conj_sym, bidirectional,
                block_len=256, use_packed_gemm=True,
                use_triton_scan=True):

      input_fp32 = input_sequence.astype(np.float32)

      # B@u (complex)
      input_T = input_fp32.T.astype(np.bfloat16)
      B_re = B_bar.real.astype(np.bfloat16)
      B_im = B_bar.imag.astype(np.bfloat16)

      if use_packed_gemm:
          Bu_re, Bu_im = _pack_complex_matmul_real_input(B_re, B_im, input_T)
      else:
          Bu_re = np.matmul(B_re, input_T)
          Bu_im = np.matmul(B_im, input_T)

      Bu_re = Bu_re.astype(np.float32).T  # (L, P)
      Bu_im = Bu_im.astype(np.float32).T

      # SSD scan
      lam_re = Lambda_bar.real.astype(np.float32)
      lam_im = Lambda_bar.imag.astype(np.float32)

      if use_triton_scan:
          if not TRITON_AVAILABLE:
              raise RuntimeError("Triton not available")
          x_re, x_im = ssd_scan_triton(lam_re, lam_im, Bu_re, Bu_im, block_len)
          xs = x_re + 1j * x_im
      else:
          xs = _ssd_block_scan_jax(Lambda_bar, Bu_re + 1j * Bu_im, block_len)

      if bidirectional:
          xs_bwd = _ssd_block_scan_jax(Lambda_bar, (Bu_re + 1j * Bu_im)[::-1], block_len)[::-1]
          xs = np.concatenate([xs, xs_bwd], axis=-1)

      # C@x (complex) -> real
      xs_T = xs.T
      C_re = C_tilde.real.astype(np.bfloat16)
      C_im = C_tilde.imag.astype(np.bfloat16)
      xs_re = xs_T.real.astype(np.bfloat16)
      xs_im = xs_T.imag.astype(np.bfloat16)

      if use_packed_gemm:
          ys_re = _pack_complex_matmul_real_output(C_re, C_im, xs_re, xs_im)
      else:
          ys_re = np.matmul(C_re, xs_re) - np.matmul(C_im, xs_im)

      ys = (2 * ys_re if conj_sym else ys_re).T.astype(np.float32)
      return ys


  # -----------------------------------------------------------------------------
  # Module
  # -----------------------------------------------------------------------------
  class SSDSSM(nn.Module):
      Lambda_re_init: jax.Array
      Lambda_im_init: jax.Array
      V: jax.Array
      Vinv: jax.Array
      H: int
      P: int
      C_init: str
      discretization: str
      dt_min: float
      dt_max: float
      conj_sym: bool = True
      clip_eigs: bool = False
      bidirectional: bool = False
      step_rescale: float = 1.0
      block_len: int = 256
      use_packed_gemm: bool = True
      use_triton_scan: bool = True

      def setup(self):
          if self.conj_sym:
              local_P = 2 * self.P
          else:
              local_P = self.P

          self.Lambda_re = self.param("Lambda_re", lambda rng, shape: self.Lambda_re_init, (None,))
          self.Lambda_im = self.param("Lambda_im", lambda rng, shape: self.Lambda_im_init, (None,))
          if self.clip_eigs:
              self.Lambda = np.clip(self.Lambda_re, None, -1e-4) + 1j * self.Lambda_im
          else:
              self.Lambda = self.Lambda_re + 1j * self.Lambda_im

          # B
          B_init = lecun_normal()
          B_shape = (local_P, self.H)
          self.B = self.param("B",
                              lambda rng, shape: init_VinvB(B_init, rng, shape, self.Vinv),
                              B_shape)
          B_tilde = self.B[..., 0] + 1j * self.B[..., 1]

          # C
          if self.C_init in ["trunc_standard_normal"]:
              C_init = trunc_standard_normal
              C_shape = (self.H, local_P, 2)
          elif self.C_init in ["lecun_normal"]:
              C_init = lecun_normal()
              C_shape = (self.H, local_P, 2)
          elif self.C_init in ["complex_normal"]:
              C_init = normal(stddev=0.5 ** 0.5)
          else:
              raise NotImplementedError("C_init method {} not implemented".format(self.C_init))

          if self.C_init in ["complex_normal"]:
              if self.bidirectional:
                  C = self.param("C", C_init, (self.H, 2 * self.P, 2))
                  self.C_tilde = C[..., 0] + 1j * C[..., 1]
              else:
                  C = self.param("C", C_init, (self.H, self.P, 2))
                  self.C_tilde = C[..., 0] + 1j * C[..., 1]
          else:
              if self.bidirectional:
                  self.C1 = self.param("C1",
                                       lambda rng, shape: init_CV(C_init, rng, shape, self.V),
                                       C_shape)
                  self.C2 = self.param("C2",
                                       lambda rng, shape: init_CV(C_init, rng, shape, self.V),
                                       C_shape)
                  C1 = self.C1[..., 0] + 1j * self.C1[..., 1]
                  C2 = self.C2[..., 0] + 1j * self.C2[..., 1]
                  self.C_tilde = np.concatenate((C1, C2), axis=-1)
              else:
                  self.C = self.param("C",
                                      lambda rng, shape: init_CV(C_init, rng, shape, self.V),
                                      C_shape)
                  self.C_tilde = self.C[..., 0] + 1j * self.C[..., 1]

          # D
          self.D = self.param("D", normal(stddev=1.0), (self.H,))

          # log_step
          self.log_step = self.param("log_step",
                                     init_log_steps,
                                     (self.P, self.dt_min, self.dt_max))
          step = self.step_rescale * np.exp(self.log_step[:, 0])

          if self.discretization in ["zoh"]:
          elif self.discretization in ["bilinear"]:
              self.Lambda_bar, self.B_bar = discretize_bilinear(self.Lambda, B_tilde, step)
          else:
              raise NotImplementedError("Discretization method {} not implemented".format(self.discretization))

      def __call__(self, input_sequence):
          input_dtype = input_sequence.dtype
          input_fp32 = input_sequence.astype(np.float32)

          ys = apply_ssd(
              self.Lambda_bar,
              self.B_bar,
              self.C_tilde,
              input_fp32,
              self.conj_sym,
              self.bidirectional,
              block_len=self.block_len,
              use_packed_gemm=self.use_packed_gemm,
              use_triton_scan=self.use_triton_scan,
          )

          Du = self.D * input_fp32
          output = ys + Du
          return output.astype(input_dtype)


  def init_SSDSSM(H,
                  P,
                  Lambda_re_init,
                  Lambda_im_init,
                  V,
                  Vinv,
                  C_init,
                  discretization,
                  dt_min,
                  dt_max,
                  conj_sym,
                  clip_eigs,
                  bidirectional,
                  block_len=256,
                  use_packed_gemm=True,
                  use_triton_scan=True):
