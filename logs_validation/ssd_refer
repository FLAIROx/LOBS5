  # s5/ssd.py
  # Complex SSD with Triton scan only (no fallback).

  from __future__ import annotations

  import jax
  import jax.numpy as jnp
  from flax import linen as nn

  from .ssd_triton import ssd_scan_triton


  def _cmul(re1, im1, re2, im2):
      return re1 * re2 - im1 * im2, re1 * im2 + im1 * re2


  def _cdiv(n_re, n_im, d_re, d_im, eps=1e-12):
      den = d_re * d_re + d_im * d_im + eps
      out_re = (n_re * d_re + n_im * d_im) / den
      out_im = (n_im * d_re - n_re * d_im) / den
      return out_re, out_im


  def discretize_zoh_complex(A_re, A_im, B_re, B_im, dt):
      # A, B: complex, dt: real
      dt = dt.astype(jnp.float32)
      exp_re = jnp.exp(A_re * dt) * jnp.cos(A_im * dt)
      exp_im = jnp.exp(A_re * dt) * jnp.sin(A_im * dt)

      num_re = exp_re - 1.0
      num_im = exp_im
      scale_re, scale_im = _cdiv(num_re, num_im, A_re, A_im)

      Bd_re, Bd_im = _cmul(scale_re[:, None], scale_im[:, None], B_re, B_im)
      return exp_re, exp_im, Bd_re, Bd_im


  def discretize_bilinear_complex(A_re, A_im, B_re, B_im, dt):
      # A_d = (I + 0.5 dt A) / (I - 0.5 dt A)
      dt = dt.astype(jnp.float32)
      half = 0.5 * dt
      n_re = 1.0 + half * A_re
      n_im = half * A_im
      d_re = 1.0 - half * A_re
      d_im = -half * A_im

      Ad_re, Ad_im = _cdiv(n_re, n_im, d_re, d_im)
      Bd_scale_re, Bd_scale_im = _cdiv(dt, 0.0, d_re, d_im)
      Bd_re, Bd_im = _cmul(Bd_scale_re[:, None], Bd_scale_im[:, None], B_re, B_im)
      return Ad_re, Ad_im, Bd_re, Bd_im


  def ssd_scan_complex(A_re, A_im, B_re, B_im, block_len=256, block_p=128):
      if B_re.ndim == 2:
          return ssd_scan_triton(A_re, A_im, B_re, B_im, block_len, block_p)

      # Map over batch dims using lax.map (no vmap batching of Triton)
      lead = B_re.shape[:-2]
      L, P = B_re.shape[-2], B_re.shape[-1]
      B_re_flat = B_re.reshape((-1, L, P))
      B_im_flat = B_im.reshape((-1, L, P))

      B_pack = jnp.stack([B_re_flat, B_im_flat], axis=1)  # (B,2,L,P)

      def scan_one(b_pack):
          b_re = b_pack[0]
          b_im = b_pack[1]
          return ssd_scan_triton(A_re, A_im, b_re, b_im, block_len, block_p)

      out_re, out_im = jax.lax.map(scan_one, B_pack)
      out_re = out_re.reshape(lead + (L, P))
      out_im = out_im.reshape(lead + (L, P))
      return out_re, out_im


  def apply_ssd_complex(
      A_re, A_im, B_re, B_im, C_re, C_im, D,
      input_sequence,
      conj_sym=False,
      bidirectional=False,
      block_len=256,
      block_p=128,
      return_complex=False,
      use_zoh=True,
      log_dt=None,
  ):
      input_fp32 = input_sequence.astype(jnp.float32)
      lead = input_fp32.shape[:-2]
      L, H = input_fp32.shape[-2], input_fp32.shape[-1]

      if log_dt is None:
          dt = jnp.ones_like(A_re)
      else:
          dt = jnp.exp(log_dt.astype(jnp.float32))

      if use_zoh:
          lam_re, lam_im, Bd_re, Bd_im = discretize_zoh_complex(A_re, A_im, B_re, B_im, dt)
      else:
          lam_re, lam_im, Bd_re, Bd_im = discretize_bilinear_complex(A_re, A_im, B_re, B_im, dt)

      # B @ u
      B_re_tc = Bd_re.astype(jnp.bfloat16)
      B_im_tc = Bd_im.astype(jnp.bfloat16)
      u_T = jnp.swapaxes(input_fp32, -1, -2).astype(jnp.bfloat16)  # (..., H, L)

      Bu_re = jnp.matmul(B_re_tc, u_T)  # (..., P, L)
      Bu_im = jnp.matmul(B_im_tc, u_T)

      Bu_re = jnp.swapaxes(Bu_re, -1, -2).astype(jnp.float32)  # (..., L, P)
      Bu_im = jnp.swapaxes(Bu_im, -1, -2).astype(jnp.float32)

      A_re_full = jnp.ones((L, A_re.shape[0]), dtype=jnp.float32) * lam_re[None, :]
      A_im_full = jnp.ones((L, A_im.shape[0]), dtype=jnp.float32) * lam_im[None, :]

      if bidirectional:
          x_re_f, x_im_f = ssd_scan_complex(A_re_full, A_im_full, Bu_re, Bu_im, block_len, block_p)
          Bu_re_rev = jnp.flip(Bu_re, axis=-2)
          Bu_im_rev = jnp.flip(Bu_im, axis=-2)
          x_re_b, x_im_b = ssd_scan_complex(A_re_full, A_im_full, Bu_re_rev, Bu_im_rev, block_len, block_p)
          x_re = x_re_f + jnp.flip(x_re_b, axis=-2)
          x_im = x_im_f + jnp.flip(x_im_b, axis=-2)
      else:
          x_re, x_im = ssd_scan_complex(A_re_full, A_im_full, Bu_re, Bu_im, block_len, block_p)

      # C @ x
      C_re_tc = C_re.astype(jnp.bfloat16)
      C_im_tc = C_im.astype(jnp.bfloat16)

      x_re_T = jnp.swapaxes(x_re, -1, -2).astype(jnp.bfloat16)  # (..., P, L)
      x_im_T = jnp.swapaxes(x_im, -1, -2).astype(jnp.bfloat16)

      y_re = jnp.matmul(C_re_tc, x_re_T) - jnp.matmul(C_im_tc, x_im_T)  # (..., H, L)
      y_im = jnp.matmul(C_re_tc, x_im_T) + jnp.matmul(C_im_tc, x_re_T)

      y_re = jnp.swapaxes(y_re, -1, -2).astype(jnp.float32)  # (..., L, H)
      y_im = jnp.swapaxes(y_im, -1, -2).astype(jnp.float32)

      if conj_sym:
          y_re = 2.0 * y_re

      Du = input_fp32 * D.reshape((1,) * len(lead) + (1, H))
      out_re = y_re + Du
      out_im = y_im

      if return_complex:
          return out_re + 1j * out_im
      return out_re


  class SSDSSM(nn.Module):
      H: int
      P: int
      dtype: jnp.dtype = jnp.bfloat16
      param_dtype: jnp.dtype = jnp.float32
      conj_sym: bool = True
      bidirectional: bool = False
      block_len: int = 256
      block_p: int = 128
      return_complex: bool = False
      use_zoh: bool = True

      def setup(self):
          self.log_A_real = self.param("log_A_real", nn.initializers.normal(0.2), (self.P,), self.param_dtype)
          self.A_im = self.param("A_im", nn.initializers.uniform(scale=1.0), (self.P,), self.param_dtype)
          self.log_dt = self.param("log_dt", nn.initializers.zeros, (self.P,), self.param_dtype)
          self.B_im = self.param("B_im", nn.initializers.normal(0.02), (self.P, self.H), self.param_dtype)

          self.C_re = self.param("C_re", nn.initializers.normal(0.02), (self.H, self.P), self.param_dtype)
          self.C_im = self.param("C_im", nn.initializers.normal(0.02), (self.H, self.P), self.param_dtype)

          self.D = self.param("D", nn.initializers.zeros, (self.H,), self.param_dtype)

      def __call__(self, input_sequence):
          A_re = -jnp.exp(self.log_A_real.astype(jnp.float32))
          A_im = self.A_im.astype(jnp.float32)
          B_re = self.B_re.astype(jnp.float32)
          B_im = self.B_im.astype(jnp.float32)
          C_re = self.C_re.astype(jnp.float32)
          C_im = self.C_im.astype(jnp.float32)
          D = self.D.astype(jnp.float32)
          log_dt = self.log_dt.astype(jnp.float32)

          out = apply_ssd_complex(
              A_re, A_im, B_re, B_im, C_re, C_im, D,
              input_sequence,
              conj_sym=self.conj_sym,
              bidirectional=self.bidirectional,
              block_len=self.block_len,
              block_p=self.block_p,
              return_complex=self.return_complex,
              use_zoh=self.use_zoh,
              log_dt=log_dt,
          )

          if self.return_complex:
              return out
          return out.astype(self.dtype)

      def __call_rnn__(self, hidden, input_sequence, resets):
          # Simple sequential scan (CPU/JAX), for compatibility
          A_re = -jnp.exp(self.log_A_real.astype(jnp.float32))
          A_im = self.A_im.astype(jnp.float32)
          B_re = self.B_re.astype(jnp.float32)
          B_im = self.B_im.astype(jnp.float32)
          C_re = self.C_re.astype(jnp.float32)
          C_im = self.C_im.astype(jnp.float32)
          D = self.D.astype(jnp.float32)
          dt = jnp.exp(self.log_dt.astype(jnp.float32))

          if self.use_zoh:
              lam_re, lam_im, Bd_re, Bd_im = discretize_zoh_complex(A_re, A_im, B_re, B_im, dt)
          else:
              lam_re, lam_im, Bd_re, Bd_im = discretize_bilinear_complex(A_re, A_im, B_re, B_im, dt)

          def step(carry, inp):
              x_re, x_im = carry
              u = inp
              Bu_re = jnp.matmul(Bd_re, u)
              Bu_im = jnp.matmul(Bd_im, u)
              x_re, x_im = _cmul(lam_re, lam_im, x_re, x_im)
              x_re = x_re + Bu_re
              x_im = x_im + Bu_im
              y_re = jnp.matmul(C_re, x_re) - jnp.matmul(C_im, x_im)
              y_im = jnp.matmul(C_re, x_im) + jnp.matmul(C_im, x_re)
              if self.conj_sym:
                  y_re = 2.0 * y_re
              y_re = y_re + D * u
              return (x_re, x_im), y_re

          (x_re, x_im), y = jax.lax.scan(step, hidden, input_sequence)
          return (x_re, x_im), y.astype(self.dtype)

