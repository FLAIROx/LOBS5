          out = ssd_scan_reference(lam_re, lam_im, bu_re, bu_im)
          return out, (lam_re, lam_im, bu_re, bu_im, block_len, block_p)
      out = _ssd_scan_triton_impl(lam_re, lam_im, bu_re, bu_im, block_len, block_p)
      return out, (lam_re, lam_im, bu_re, bu_im, block_len, block_p)


