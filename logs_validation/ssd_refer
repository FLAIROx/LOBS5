  import jax
  import jax.numpy as jnp

  def c_mul(a_re, a_im, b_re, b_im):
      return a_re * b_re - a_im * b_im, a_re * b_im + a_im * b_re

  def c_add(a_re, a_im, b_re, b_im):
      return a_re + b_re, a_im + b_im

  # associative_scan 二元操作 (A,B) ⊕ (C,D) = (C*A, D + C*B)
  def ssd_binary_op(lhs, rhs):
      a_re, a_im, b_re, b_im = lhs
      c_re, c_im, d_re, d_im = rhs

      # A = C * A
      A_re, A_im = c_mul(c_re, c_im, a_re, a_im)

      # B = D + C * B
      CB_re, CB_im = c_mul(c_re, c_im, b_re, b_im)
      B_re, B_im = c_add(d_re, d_im, CB_re, CB_im)

      return (A_re, A_im, B_re, B_im)

  def ssd_scan_real2(lam_re, lam_im, bu_re, bu_im):
      # lam_re, lam_im, bu_re, bu_im: (L, P)
      _, _, xs_re, xs_im = jax.lax.associative_scan(
          ssd_binary_op, (lam_re, lam_im, bu_re, bu_im)
      )
      return xs_re, xs_im

  def pack_B_real2(B_re, B_im):
      # (P,H) -> (2P,H)
      return jnp.concatenate([B_re, B_im], axis=0)

  def bu_from_pack(B_pack, u):
      # B_pack: (2P,H), u: (H,L)
      t = B_pack @ u  # (2P,L)
      P = t.shape[0] // 2
      t_re = t[:P]
      bu_im = t_im + t_re
      return bu_re, bu_im

  def pack_C_real2(C_re, C_im):
      # (H,P) -> (H,2P) for real output
      return jnp.concatenate([C_re, -C_im], axis=1)

  def apply_ssd_real2(lam_re, lam_im, B_re, B_im, C_re, C_im, D, u, dt):
      """
      lam_re/lam_im: (P,)
      B_re/B_im: (P,H)
      C_re/C_im: (H,P)
      u: (L,H) real
      D: (H,) real
      """

      # 1) Discretize (ZOH) in complex, keep re/im
      # exp(lam*dt) = e^a (cos b + i sin b)
      a = lam_re * dt
      b = lam_im * dt
      exp_re = jnp.exp(a) * jnp.cos(b)
      exp_im = jnp.exp(a) * jnp.sin(b)

      # k = (exp - 1) / lam
      num_re = exp_re - 1.0
      num_im = exp_im
      denom = lam_re * lam_re + lam_im * lam_im + 1e-12
      k_re = (num_re * lam_re + num_im * lam_im) / denom
      k_im = (num_im * lam_re - num_re * lam_im) / denom

      # B_bar = k * B
      Bbar_re, Bbar_im = c_mul(k_re[:, None], k_im[:, None], B_re, B_im)
      # Lambda_bar = exp(lam*dt)
      lam_re = exp_re
      lam_im = exp_im

      # 2) B@u (packed real2)
      u_T = u.T  # (H,L)
      B_pack = pack_B_real2(Bbar_re, Bbar_im)
      bu_re, bu_im = bu_from_pack(B_pack, u_T)  # (P,L)

      # 3) Scan
      lam_re_L = jnp.broadcast_to(lam_re[:, None], bu_re.shape)
      lam_im_L = jnp.broadcast_to(lam_im[:, None], bu_im.shape)
      xs_re, xs_im = ssd_scan_real2(lam_re_L.T, lam_im_L.T, bu_re.T, bu_im.T)  # (L,P)

      # 4) C@x (real output)
      x_pack = jnp.concatenate([xs_re, xs_im], axis=1).T  # (2P,L)
      C_pack = pack_C_real2(C_re, C_im)  # (H,2P)
      y = (C_pack @ x_pack).T  # (L,H)

      # 5) D feedthrough
      y = y + u * D[None, :]
      return y

