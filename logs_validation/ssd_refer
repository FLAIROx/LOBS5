      ):
          pid_t = tl.program_id(0)
          pid_p = tl.program_id(1)

          offs_p = pid_p * BLOCK_P + tl.arange(0, BLOCK_P)
          mask_p = offs_p < P

          a_re = tl.full([BLOCK_P], 1.0, tl.float32)
          a_im = tl.zeros([BLOCK_P], tl.float32)
          x_re = tl.zeros([BLOCK_P], tl.float32)
          x_im = tl.zeros([BLOCK_P], tl.float32)

          base = pid_t * BLOCK_T

          for t in tl.static_range(0, BLOCK_T):
              idx = base + t
              mask_t = idx < L

              lam_re = tl.load(lam_re_ptr + idx * P + offs_p, mask=mask_p & mask_t, other=1.0)
              lam_im = tl.load(lam_im_ptr + idx * P + offs_p, mask=mask_p & mask_t, other=0.0)
              bu_re = tl.load(bu_re_ptr + idx * P + offs_p, mask=mask_p & mask_t, other=0.0)
              bu_im = tl.load(bu_im_ptr + idx * P + offs_p, mask=mask_p & mask_t, other=0.0)

              tmp_re = lam_re * x_re - lam_im * x_im + bu_re
              tmp_im = lam_re * x_im + lam_im * x_re + bu_im
              x_re = tmp_re
              x_im = tmp_im

              tmpa_re = lam_re * a_re - lam_im * a_im
              tmpa_im = lam_re * a_im + lam_im * a_re
              a_re = tmpa_re
              a_im = tmpa_im

          stride_k = n_blocks * P
          base_out = pid_t * P + offs_p

          tl.store(out_ptr + 0 * stride_k + base_out, a_re, mask=mask_p)
          tl.store(out_ptr + 1 * stride_k + base_out, a_im, mask=mask_p)
          tl.store(out_ptr + 2 * stride_k + base_out, x_re, mask=mask_p)
          tl.store(out_ptr + 3 * stride_k + base_out, x_im, mask=mask_p)


