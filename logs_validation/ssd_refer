      def binary_op(x, y):
          a1_re, a1_im, b1_re, b1_im = x
          a2_re, a2_im, b2_re, b2_im = y
          a_re_o, a_im_o = _cmul(a2_re, a2_im, a1_re, a1_im)
          t_re, t_im = _cmul(a2_re, a2_im, b1_re, b1_im)
          b_re_o = b2_re + t_re
          b_im_o = b2_im + t_im
          return (a_re_o, a_im_o, b_re_o, b_im_o)

      _, _, x_end_re, x_end_im = jax.lax.associative_scan(
          binary_op, (a_prod_re, a_prod_im, b_end_re, b_end_im)
      )

      zero = jnp.zeros((1, P), dtype=jnp.float32)
      x0_re = jnp.concatenate([zero, x_end_re[:-1]], axis=0)
      x0_im = jnp.concatenate([zero, x_end_im[:-1]], axis=0)

      out_shape = jax.ShapeDtypeStruct((2, L_pad, P), jnp.float32)
      out = jt.triton_call(
          a_re, a_im, b_re, b_im, x0_re, x0_im,
          kernel=_ssd_block_apply_kernel,
          out_shape=out_shape,
          grid=grid,
          L=L_pad, P=P, N_BLOCKS=n_blocks,
          BLOCK_LEN=block_len, BLOCK_P=block_p,
      )

      x_re = out[0][:L]
      x_im = out[1][:L]
      return x_re, x_im


