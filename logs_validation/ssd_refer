  class SSDSelective(nn.Module):
      H: int
      P: int
      dtype: Any = jax.numpy.float32

      def setup(self):
          # Input -> (delta, B, C)
          self.in_proj = nn.Dense(3 * self.P, dtype=self.dtype)
          self.u_proj = nn.Dense(self.P, dtype=self.dtype)
          self.out_proj = nn.Dense(self.H, dtype=self.dtype)

          # Real diagonal A (negative)

      def __call__(self, x):
          # x: (L, H)
          x_fp32 = x.astype(np.float32)

          # Project input
          u = self.u_proj(x_fp32)  # (L, P)
          z = self.in_proj(x_fp32) # (L, 3P)
          delta_raw, B_t, C_t = np.split(z, 3, axis=-1)

          # Selective delta
          delta = jax.nn.softplus(delta_raw)  # (L, P)
          A = -jax.nn.softplus(self.A_log)    # (P,)

          # Lambda per timestep
          Lambda_seq = np.exp(delta * A)      # (L, P)

          # Bu per timestep
          Bu = B_t * u                        # (L, P)

          # Scan
          _, xs = jax.lax.associative_scan(binary_operator, (Lambda_seq, Bu))

          # Selective output
          y_state = C_t * xs                  # (L, P)
          y = self.out_proj(y_state)          # (L, H)

          # D feedthrough
          y = y + self.D * x_fp32
          return y.astype(x.dtype)

  self.seq = self.ssm(step_rescale=self.step_rescale)

