  from functools import partial

  import jax
  import jax.numpy as jnp
  from flax import linen as nn
  from jax.nn.initializers import lecun_normal, normal

  from .ssm_init import init_CV, init_VinvB, init_log_steps, trunc_standard_normal

  try:
      from .ssd_triton import ssd_scan_triton, TRITON_AVAILABLE
  except Exception:
      ssd_scan_triton = None
      TRITON_AVAILABLE = False


  def _cmul(ar, ai, br, bi):
      return ar * br - ai * bi, ar * bi + ai * br


  def _cmul_add(ar, ai, br, bi, cr, ci):
      pr, pi = _cmul(ar, ai, br, bi)
      return pr + cr, pi + ci


  def _safe_complex_inv(z, eps=1e-6):
      denom = z.real * z.real + z.imag * z.imag + eps
      return jnp.conj(z) / denom


  def discretize_zoh_complex(Lambda, B_tilde, Delta):
      lam_bar = jnp.exp(Lambda * Delta)
      inv_lam = _safe_complex_inv(Lambda)
      B_bar = (inv_lam * (lam_bar - 1.0))[..., None] * B_tilde
      return lam_bar, B_bar


  def discretize_bilinear_complex(Lambda, B_tilde, Delta):
      one = jnp.ones_like(Lambda)
      bl = 1.0 / (one - 0.5 * Delta * Lambda)
      lam_bar = bl * (one + 0.5 * Delta * Lambda)
      B_bar = (bl * Delta)[..., None] * B_tilde
      return lam_bar, B_bar


  def _assoc_op(lhs, rhs):
      (a1r, a1i), (b1r, b1i) = lhs
      (a2r, a2i), (b2r, b2i) = rhs
      ar, ai = _cmul(a2r, a2i, a1r, a1i)
      br, bi = _cmul_add(a2r, a2i, b1r, b1i, b2r, b2i)
      return (ar, ai), (br, bi)


  def ssd_block_scan_complex(lam_re, lam_im, bu_re, bu_im, block_len=256):
      lam_re = lam_re.astype(jnp.float32)
      lam_im = lam_im.astype(jnp.float32)
      bu_re = bu_re.astype(jnp.float32)
      bu_im = bu_im.astype(jnp.float32)

      if lam_re.ndim == 1:
          lam_re = jnp.broadcast_to(lam_re[None, :], bu_re.shape)
          lam_im = jnp.broadcast_to(lam_im[None, :], bu_re.shape)

      L, P = bu_re.shape
      if block_len <= 0 or block_len >= L:
          (ar, ai), (xr, xi) = jax.lax.associative_scan(
              _assoc_op, ((lam_re, lam_im), (bu_re, bu_im)), axis=0
          )
          return xr, xi

      pad = (-L) % block_len
      if pad:
          lam_re = jnp.pad(lam_re, ((0, pad), (0, 0)), constant_values=1.0)
          lam_im = jnp.pad(lam_im, ((0, pad), (0, 0)), constant_values=0.0)
          bu_re = jnp.pad(bu_re, ((0, pad), (0, 0)), constant_values=0.0)
          bu_im = jnp.pad(bu_im, ((0, pad), (0, 0)), constant_values=0.0)

      Lp = bu_re.shape[0]
      n_blocks = Lp // block_len

      lam_re = lam_re.reshape(n_blocks, block_len, P)
      lam_im = lam_im.reshape(n_blocks, block_len, P)
      bu_re = bu_re.reshape(n_blocks, block_len, P)
      bu_im = bu_im.reshape(n_blocks, block_len, P)

      (a_scan_re, a_scan_im), (x_local_re, x_local_im) = jax.lax.associative_scan(
          _assoc_op, ((lam_re, lam_im), (bu_re, bu_im)), axis=1
      )

      a_blk_re = a_scan_re[:, -1, :]
      a_blk_im = a_scan_im[:, -1, :]
      b_blk_re = x_local_re[:, -1, :]
      b_blk_im = x_local_im[:, -1, :]

      (a_pref_re, a_pref_im), (b_pref_re, b_pref_im) = jax.lax.associative_scan(
          _assoc_op, ((a_blk_re, a_blk_im), (b_blk_re, b_blk_im)), axis=0
      )

      x0_re = jnp.concatenate([jnp.zeros_like(b_pref_re[:1]), b_pref_re[:-1]], axis=0)
      x0_im = jnp.concatenate([jnp.zeros_like(b_pref_im[:1]), b_pref_im[:-1]], axis=0)
      x0_re = x0_re[:, None, :]
      x0_im = x0_im[:, None, :]

      ax0_re, ax0_im = _cmul(a_scan_re, a_scan_im, x0_re, x0_im)
      x_re = x_local_re + ax0_re
      x_im = x_local_im + ax0_im

      x_re = x_re.reshape(Lp, P)[:L]
      x_im = x_im.reshape(Lp, P)[:L]
      return x_re, x_im


  def ssd_scan_complex(lam_re, lam_im, bu_re, bu_im, block_len=256, use_triton=False, triton_block_p=128):
      if use_triton and TRITON_AVAILABLE and ssd_scan_triton is not None:
          return ssd_scan_triton(lam_re, lam_im, bu_re, bu_im, block_len, triton_block_p)
      return ssd_block_scan_complex(lam_re, lam_im, bu_re, bu_im, block_len)


  def apply_ssd_complex(
      Lambda_bar,
      B_bar,
      C_tilde,
      input_sequence,
      conj_sym,
      bidirectional,
      block_len=256,
      use_triton=False,
      triton_block_p=128,
  ):
      input_fp32 = input_sequence.astype(jnp.float32)

      input_T = input_fp32.T.astype(jnp.bfloat16)
      B_re = B_bar.real.astype(jnp.bfloat16)
      B_im = B_bar.imag.astype(jnp.bfloat16)

      Bu_re = jnp.matmul(B_re, input_T)
      Bu_im = jnp.matmul(B_im, input_T)
      bu_re = Bu_re.astype(jnp.float32).T
      bu_im = Bu_im.astype(jnp.float32).T

      lam_re = jnp.real(Lambda_bar).astype(jnp.float32)
      lam_im = jnp.imag(Lambda_bar).astype(jnp.float32)

      lam_re = jnp.broadcast_to(lam_re[None, :], bu_re.shape)
      lam_im = jnp.broadcast_to(lam_im[None, :], bu_re.shape)

      x_re, x_im = ssd_scan_complex(
          lam_re, lam_im, bu_re, bu_im,
          block_len=block_len,
          use_triton=use_triton,
          triton_block_p=triton_block_p,
      )

      if bidirectional:
          x_re_b, x_im_b = ssd_scan_complex(
              lam_re[::-1], lam_im[::-1], bu_re[::-1], bu_im[::-1],
              block_len=block_len,
              use_triton=use_triton,
              triton_block_p=triton_block_p,
          )
          x_re = jnp.concatenate([x_re, x_re_b[::-1]], axis=-1)
          x_im = jnp.concatenate([x_im, x_im_b[::-1]], axis=-1)

      xs_re = x_re.T.astype(jnp.bfloat16)
      xs_im = x_im.T.astype(jnp.bfloat16)
      C_re = C_tilde.real.astype(jnp.bfloat16)
      C_im = C_tilde.imag.astype(jnp.bfloat16)

      ys_re = jnp.matmul(C_re, xs_re) - jnp.matmul(C_im, xs_im)
      ys = (2.0 * ys_re if conj_sym else ys_re).T.astype(jnp.float32)
      return ys


  class SSDSSM(nn.Module):
      Lambda_re_init: jax.Array
      Lambda_im_init: jax.Array
      V: jax.Array
      Vinv: jax.Array
      H: int
      P: int
      C_init: str
      discretization: str
      dt_min: float
      dt_max: float
      conj_sym: bool = True
      clip_eigs: bool = False
      bidirectional: bool = False
      step_rescale: float = 1.0
      block_len: int = 256
      use_triton: bool = False
      triton_block_p: int = 128

      def setup(self):
          if self.conj_sym:
              local_P = 2 * self.P
          else:
              local_P = self.P

          self.Lambda_re = self.param("Lambda_re", lambda rng, shape: self.Lambda_re_init, (None,))
          self.Lambda_im = self.param("Lambda_im", lambda rng, shape: self.Lambda_im_init, (None,))
          if self.clip_eigs:
              self.Lambda = jnp.clip(self.Lambda_re, None, -1e-4) + 1j * self.Lambda_im
          else:
              self.Lambda = self.Lambda_re + 1j * self.Lambda_im

          B_init = lecun_normal()
          B_shape = (local_P, self.H)
          self.B = self.param(
              "B",
              lambda rng, shape: init_VinvB(B_init, rng, shape, self.Vinv),
              B_shape,
          )
          B_tilde = self.B[..., 0] + 1j * self.B[..., 1]

          if self.C_init in ["trunc_standard_normal"]:
              C_init = trunc_standard_normal
              C_shape = (self.H, local_P, 2)
          elif self.C_init in ["lecun_normal"]:
              C_init = lecun_normal()
              C_shape = (self.H, local_P, 2)
          elif self.C_init in ["complex_normal"]:
              C_init = normal(stddev=0.5 ** 0.5)
          else:
              raise NotImplementedError("C_init method {} not implemented".format(self.C_init))

          if self.C_init in ["complex_normal"]:
              if self.bidirectional:
                  C = self.param("C", C_init, (self.H, 2 * self.P, 2))
                  self.C_tilde = C[..., 0] + 1j * C[..., 1]
              else:
                  C = self.param("C", C_init, (self.H, self.P, 2))
                  self.C_tilde = C[..., 0] + 1j * C[..., 1]
          else:
              if self.bidirectional:
                  self.C1 = self.param("C1", lambda rng, shape: init_CV(C_init, rng, shape, self.V), C_shape)
                  self.C2 = self.param("C2", lambda rng, shape: init_CV(C_init, rng, shape, self.V), C_shape)
                  C1 = self.C1[..., 0] + 1j * self.C1[..., 1]
                  C2 = self.C2[..., 0] + 1j * self.C2[..., 1]
                  self.C_tilde = jnp.concatenate((C1, C2), axis=-1)
              else:
                  self.C = self.param("C", lambda rng, shape: init_CV(C_init, rng, shape, self.V), C_shape)
                  self.C_tilde = self.C[..., 0] + 1j * self.C[..., 1]

          self.D = self.param("D", normal(stddev=1.0), (self.H,))

          self.log_step = self.param("log_step", init_log_steps, (self.P, self.dt_min, self.dt_max))
          step = self.step_rescale * jnp.exp(self.log_step[:, 0])

          if self.discretization in ["zoh"]:
              self.Lambda_bar, self.B_bar = discretize_zoh_complex(self.Lambda, B_tilde, step)
          elif self.discretization in ["bilinear"]:
              self.Lambda_bar, self.B_bar = discretize_bilinear_complex(self.Lambda, B_tilde, step)
          else:
              raise NotImplementedError("Discretization method {} not implemented".format(self.discretization))

      def __call__(self, input_sequence):
          input_dtype = input_sequence.dtype
          input_fp32 = input_sequence.astype(jnp.float32)

          ys = apply_ssd_complex(
              self.Lambda_bar,
              self.B_bar,
              self.C_tilde,
              input_fp32,
              self.conj_sym,
              self.bidirectional,
              block_len=self.block_len,
              use_triton=self.use_triton,
              triton_block_p=self.triton_block_p,
          )

          Du = self.D * input_fp32
          output = ys + Du
          return output.astype(input_dtype)

      def __call_rnn__(self, hidden, input_sequence, resets):
          if self.bidirectional:
              raise ValueError("bidirectional not supported in rnn mode")

          input_fp32 = input_sequence.astype(jnp.float32)

          input_T = input_fp32.T.astype(jnp.bfloat16)
          B_re = self.B_bar.real.astype(jnp.bfloat16)
          B_im = self.B_bar.imag.astype(jnp.bfloat16)
          Bu_re = jnp.matmul(B_re, input_T).astype(jnp.float32).T
          Bu_im = jnp.matmul(B_im, input_T).astype(jnp.float32).T

          lam_re = jnp.real(self.Lambda_bar).astype(jnp.float32)
          lam_im = jnp.imag(self.Lambda_bar).astype(jnp.float32)

          if jnp.iscomplexobj(hidden):
              h_re = jnp.real(hidden)
              h_im = jnp.imag(hidden)
          else:
              h_re, h_im = hidden

          h_re = jnp.squeeze(h_re, axis=0)
          h_im = jnp.squeeze(h_im, axis=0)

          def step_fn(carry, inp):
              h_r, h_i = carry
              bu_r, bu_i, r = inp
              if r is not None:
                  h_r = jnp.where(r, 0.0, h_r)
                  h_i = jnp.where(r, 0.0, h_i)
              h_r, h_i = _cmul_add(lam_re, lam_im, h_r, h_i, bu_r, bu_i)
              return (h_r, h_i), (h_r, h_i)

          if resets is None:
              (h_re, h_im), (xs_re, xs_im) = jax.lax.scan(step_fn, (h_re, h_im), (Bu_re, Bu_im, jnp.zeros((Bu_re.shape[0],), dtype=jnp.bool_)))
          else:
              (h_re, h_im), (xs_re, xs_im) = jax.lax.scan(step_fn, (h_re, h_im), (Bu_re, Bu_im, resets))

          xs_re = xs_re.T.astype(jnp.bfloat16)
          xs_im = xs_im.T.astype(jnp.bfloat16)
          C_re = self.C_tilde.real.astype(jnp.bfloat16)
          C_im = self.C_tilde.imag.astype(jnp.bfloat16)
          ys_re = jnp.matmul(C_re, xs_re) - jnp.matmul(C_im, xs_im)
          ys = (2.0 * ys_re if self.conj_sym else ys_re).T.astype(jnp.float32)

          hidden_out = (h_re + 1j * h_im)[jnp.newaxis, :]
          Du = self.D * input_fp32
          output = ys + Du
          return hidden_out, output.astype(input_sequence.dtype)


