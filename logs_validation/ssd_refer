  def _pad_to_block(lam_re, lam_im, bu_re, bu_im, block_len):
      L, P = bu_re.shape
      pad = (-L) % block_len
      if pad:
          lam_re = jnp.pad(lam_re, ((0, pad), (0, 0)), constant_values=1.0)
          lam_im = jnp.pad(lam_im, ((0, pad), (0, 0)), constant_values=0.0)
          bu_re = jnp.pad(bu_re, ((0, pad), (0, 0)), constant_values=0.0)
          bu_im = jnp.pad(bu_im, ((0, pad), (0, 0)), constant_values=0.0)
      return lam_re, lam_im, bu_re, bu_im, L


  def _ssd_scan_triton_impl(lam_re, lam_im, bu_re, bu_im, block_len=256, block_p=128):
      lam_re = lam_re.astype(jnp.float32)
      lam_im = lam_im.astype(jnp.float32)
      bu_re = bu_re.astype(jnp.float32)
      bu_im = bu_im.astype(jnp.float32)
      Lp, P = bu_re.shape
      n_blocks = Lp // block_len

      grid = (n_blocks, triton.cdiv(P, block_p))
      out_summary = jt.triton_call(
          lam_re, lam_im, bu_re, bu_im,
          kernel=_ssd_block_summary_kernel,
          out_shape=jax.ShapeDtypeStruct((4, n_blocks, P), jnp.float32),
          grid=grid,
          L=Lp, P=P, n_blocks=n_blocks,
          BLOCK_T=block_len, BLOCK_P=block_p,
      )

      a_blk_re = out_summary[0]
      a_blk_im = out_summary[1]
      b_blk_re = out_summary[2]
      b_blk_im = out_summary[3]

      (a_pref_re, a_pref_im), (b_pref_re, b_pref_im) = jax.lax.associative_scan(
          _assoc_op, ((a_blk_re, a_blk_im), (b_blk_re, b_blk_im)), axis=0
      )

      x0_re = jnp.concatenate([jnp.zeros_like(b_pref_re[:1]), b_pref_re[:-1]], axis=0)
      x0_im = jnp.concatenate([jnp.zeros_like(b_pref_im[:1]), b_pref_im[:-1]], axis=0)

      out_x = jt.triton_call(
          lam_re, lam_im, bu_re, bu_im, x0_re, x0_im,
          kernel=_ssd_block_apply_kernel,
          out_shape=jax.ShapeDtypeStruct((2, Lp, P), jnp.float32),
          grid=grid,
          L=Lp, P=P, n_blocks=n_blocks,
          BLOCK_T=block_len, BLOCK_P=block_p,
      )

      x_re = out_x[0][:L]
      x_im = out_x[1][:L]
      return x_re, x_im


