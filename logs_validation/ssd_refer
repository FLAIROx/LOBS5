          t_re, t_im = _cmul(a2_re, a2_im, b1_re, b1_im)
          b_re_o = b2_re + t_re
          b_im_o = b2_im + t_im
          return (a_re_o, a_im_o, b_re_o, b_im_o)

      _, _, x_re, x_im = jax.lax.associative_scan(binary_op, (a_re, a_im, b_re, b_im))
